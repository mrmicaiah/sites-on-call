/* Manual contacts (Gloria's "Add Contact") get string ids prefixed "m" so they
   can never collide with the Sheet's numeric 0..461 ids or with each other.
   They live ONLY in localStorage (ccState.manual) + an outcome-log Sheet row;
   they are deliberately NOT mirrored to the Progress event log, because that
   log's replay coerces leadId to Number() and would mangle a string id into
   NaN, poisoning every other browser's boot. Local-durable by design (A-now). */
function ccIsManualId(id){ return typeof id==='string' && id.charAt(0)==='m'; }
function ccNewManualId(){ return 'm'+Date.now().toString(36)+Math.random().toString(36).slice(2,7); }

function loadState(){
  try{ const s = JSON.parse(localStorage.getItem(CC_STORE_KEY)); if(s && s.done){
    if(!s.recs) s.recs={};
    if(!s.pending) s.pending={};
    if(!s.manual) s.manual={};
    // backfill records for leads marked done before history existed
    Object.keys(s.done).forEach(id=>{ if(!s.recs[id]){ s.recs[id]={id:Number(id)||id, result:s.done[id], notes:'', when:''}; } });
    // ONE-TIME migration: pull old voicemail/no-answer dispositions into the follow-up queue.
    if(!s.migratedFollowups){
      const t=ccTodayKey();
      Object.keys(s.done).forEach(id=>{
        const r=s.done[id];
        if((r==='vm' || r==='noanswer') && !s.pending[id]){
          s.pending[id] = { id:Number(id)||id, nextAction:(r==='vm'?'text':'text-noans'), due:t };
          delete s.done[id];   // it's no longer "done" — it's a pending follow-up now
        }
      });
      s.migratedFollowups=true;
    }
    return s;
  } }catch(e){}
  return { done:{}, recs:{}, pending:{}, manual:{}, filter:"All" };
}
function saveState(){ try{ localStorage.setItem(CC_STORE_KEY, JSON.stringify(ccState)); }catch(e){} }

/* ===== PHASE 2: mirror progress events to the Sheet (durability) =====
   localStorage stays the source of truth; this is a fire-and-forget mirror so
   a cleared browser can reload progress from the Sheet. Same no-cors pattern as
   the outcome-log post — we can't confirm receipt, only that the request fired. */
function ccFireEvent(ev){
  try{
    if(!CC_SHEET_URL || CC_SHEET_URL.indexOf('__SHEET')>=0) return;
    // Manual contacts have string ids; the Progress log replays leadId via
    // Number(), which would turn "m..." into NaN and corrupt every browser's
    // boot. So we never mirror manual-id events. They're local-only by design.
    if(ev && ccIsManualId(ev.leadId)) return;
    const payload = Object.assign({ kind:'event', ts:new Date().toISOString(), caller:'' }, ev);
    fetch(CC_SHEET_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(payload)}).catch(()=>{});
  }catch(e){}
}

/* ===== BACKUP: download all progress as a JSON file =====
   Exports ccState (done/recs/pending/filter) plus a readable per-lead
   summary keyed by id. This file is the safety net AND the future
   import/migration source — keep it. */
function ccBackup(){
  try{
    saveState(); // make sure the latest is captured before we read it
    const stamp = ccTodayKey();
    // Build a readable index so the file isn't just opaque IDs.
    const leadIndex = {};
    CC_LEADS.forEach(l=>{ leadIndex[l.id] = { b:l.b, pd:l.pd, c:l.c, t:l.t }; });
    const payload = {
      _type: 'sites-on-call-coldcall-backup',
      _version: 1,
      _exported: new Date().toISOString(),
      _storeKey: CC_STORE_KEY,
      counts: {
        done: Object.keys(ccState.done||{}).length,
        pending: Object.keys(ccState.pending||{}).length,
        good: Object.values(ccState.done||{}).filter(r=>r==='good').length
      },
      state: ccState,        // the actual progress — done / recs / pending / filter
      leadIndex: leadIndex   // id -> {business, phone, city, trade} for human readability
    };
    const blob = new Blob([JSON.stringify(payload, null, 2)], {type:'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'coldcall-backup-' + stamp + '.json';
    document.body.appendChild(a);
    a.click();
    setTimeout(()=>{ document.body.removeChild(a); URL.revokeObjectURL(url); }, 100);
    ccToast('✓ Backup downloaded ('+payload.counts.done+' done, '+payload.counts.pending+' in follow-up)', 'ok');
  }catch(e){
    ccToast('Backup failed — try again', 'warn');
  }
}

/* ===== follow-up engine: date helpers (real calendar, no time travel) ===== */
function ccTodayKey(){ const d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function ccAddDays(key, n){ const d=new Date(key+'T12:00:00'); d.setDate(d.getDate()+n); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function ccFmtDue(key){ try{ const d=new Date(key+'T12:00:00'); return d.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'}); }catch(e){ return key; } }
/* pending[id] = { id, nextAction:'text'|'finaltext'|'callback', due:'YYYY-MM-DD' } */
function ccDueToday(){
  const today=ccTodayKey();
  return CC_LEADS.filter(l=> ccState.pending && ccState.pending[l.id] && ccState.pending[l.id].due<=today)
                 .filter(l => ccState.filter==="All" || l.c===ccState.filter)
                 .sort((a,b)=> ccState.pending[a.id].due.localeCompare(ccState.pending[b.id].due));
}


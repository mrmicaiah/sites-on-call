---
title: Cold Call Tool — Sites On Call
noindex: true
eleventyExcludeFromCollections: true
---
{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Sites On Call — Caller App</title>
<style>
  :root {
    --bg: #0f1729;
    --panel: #1b2438;
    --panel2: #232e47;
    --line: #32405f;
    --text: #e8edf7;
    --muted: #9aa7c2;
    --accent: #4f8cff;
    --accent2: #3a6fd6;
    --green: #36c08a;
    --red: #e2615f;
    --amber: #e0a73a;
    --radius: 12px;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    font-size: 15px;
    line-height: 1.45;
  }
  a { color: var(--accent); }
  button {
    font: inherit;
    cursor: pointer;
    border: none;
    border-radius: 8px;
    padding: 9px 14px;
    background: var(--accent);
    color: white;
    transition: filter .12s ease;
  }
  button:hover { filter: brightness(1.08); }
  button:disabled { opacity: .5; cursor: not-allowed; }
  button.ghost { background: var(--panel2); color: var(--text); border: 1px solid var(--line); }
  button.danger { background: var(--red); }
  button.small { padding: 5px 10px; font-size: 13px; }
  input, select, textarea {
    font: inherit;
    background: var(--panel2);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 9px 11px;
    width: 100%;
  }
  textarea { resize: vertical; min-height: 64px; }
  label { font-size: 13px; color: var(--muted); display: block; margin-bottom: 4px; }
  .field { margin-bottom: 12px; }
  .hidden { display: none !important; }

  /* Top bar */
  header {
    display: flex; align-items: center; gap: 14px;
    padding: 12px 18px;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
    position: sticky; top: 0; z-index: 20;
    flex-wrap: wrap;
  }
  header .brand { font-weight: 700; font-size: 16px; letter-spacing: .2px; }
  header .brand span { color: var(--accent); }
  nav { display: flex; gap: 6px; }
  nav button {
    background: transparent; color: var(--muted);
    padding: 7px 12px; border-radius: 8px;
  }
  nav button.active { background: var(--panel2); color: var(--text); }
  header .spacer { flex: 1; }
  header .who { font-size: 13px; color: var(--muted); }

  main { max-width: 1080px; margin: 0 auto; padding: 18px; }

  /* Login */
  .login-wrap {
    min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;
  }
  .login-card {
    background: var(--panel); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 30px; width: 100%; max-width: 380px;
  }
  .login-card h1 { margin: 0 0 4px; font-size: 22px; }
  .login-card p.sub { margin: 0 0 22px; color: var(--muted); font-size: 14px; }

  /* Cards / panels */
  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; }
  .toolbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: end; margin-bottom: 14px; }
  .toolbar .field { margin: 0; }
  .toolbar .grow { flex: 1; min-width: 180px; }

  /* Lead list */
  .lead-row {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px; border: 1px solid var(--line);
    border-radius: 10px; margin-bottom: 8px; background: var(--panel);
    cursor: pointer;
  }
  .lead-row:hover { border-color: var(--accent); }
  .lead-row .main { flex: 1; min-width: 0; }
  .lead-row .name { font-weight: 600; }
  .lead-row .meta { color: var(--muted); font-size: 13px; }
  .lead-row .right { text-align: right; white-space: nowrap; }
  .rating { color: var(--amber); font-weight: 600; }

  .badge {
    display: inline-block; font-size: 11px; font-weight: 600;
    padding: 2px 8px; border-radius: 999px; border: 1px solid var(--line);
    color: var(--muted); background: var(--panel2);
  }
  .badge.web-none { color: #ffd0cf; border-color: #6b2e2d; background: #3a1e1e; }
  .badge.web-has { color: #cdeede; border-color: #2c5e4a; background: #1c3b30; }

  .stage-pill { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; }

  /* Detail */
  .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 18px; margin: 12px 0; }
  .detail-grid .k { color: var(--muted); font-size: 12px; }
  .detail-grid .v { font-size: 14px; word-break: break-word; }
  .pitch {
    background: #21304a; border-left: 3px solid var(--accent);
    padding: 12px 14px; border-radius: 8px; margin: 14px 0; font-size: 14px;
  }
  .section-title { font-size: 13px; text-transform: uppercase; letter-spacing: .5px; color: var(--muted); margin: 22px 0 10px; }
  .touch-item { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; margin-bottom: 8px; background: var(--panel2); }
  .touch-item .top { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; }
  .touch-item .when { color: var(--muted); }

  /* Dashboard */
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; }
  .stat { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px; text-align: center; }
  .stat .num { font-size: 28px; font-weight: 700; }
  .stat .lbl { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .4px; margin-top: 4px; }

  .row2 { display: flex; gap: 10px; }
  .row2 > * { flex: 1; }

  .empty { color: var(--muted); text-align: center; padding: 30px; }
  .toast {
    position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
    background: var(--panel2); border: 1px solid var(--line); color: var(--text);
    padding: 11px 18px; border-radius: 10px; z-index: 50; box-shadow: 0 8px 30px rgba(0,0,0,.4);
    max-width: 90vw;
  }
  .toast.err { border-color: var(--red); }
  .toast.ok { border-color: var(--green); }

  .modal-bg {
    position: fixed; inset: 0; background: rgba(0,0,0,.55);
    display: flex; align-items: center; justify-content: center; z-index: 40; padding: 18px;
  }
  .modal {
    background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 20px; width: 100%; max-width: 440px; max-height: 90vh; overflow: auto;
  }
  .modal h3 { margin: 0 0 14px; }
  .btn-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 12px; }
  .btn-grid button { background: var(--panel2); border: 1px solid var(--line); color: var(--text); }
  .btn-grid button.sel { background: var(--accent); border-color: var(--accent); color: #fff; }

  @media (max-width: 620px) {
    .detail-grid { grid-template-columns: 1fr; }
    header { gap: 8px; }
    nav button { padding: 6px 9px; font-size: 13px; }
  }
</style>
</head>
<body>

<!-- ============ LOGIN ============ -->
<div id="loginView" class="login-wrap">
  <div class="login-card">
    <h1>Sites <span style="color:var(--accent)">On Call</span></h1>
    <p class="sub">Sign in to your caller account.</p>
    <form id="loginForm">
      <div class="field">
        <label>Email</label>
        <input type="email" id="loginEmail" autocomplete="username" required />
      </div>
      <div class="field">
        <label>Password</label>
        <input type="password" id="loginPassword" autocomplete="current-password" required />
      </div>
      <button type="submit" id="loginBtn" style="width:100%;">Sign in</button>
      <p id="loginError" style="color:var(--red); font-size:13px; margin:12px 0 0;"></p>
    </form>
  </div>
</div>

<!-- ============ APP ============ -->
<div id="appView" class="hidden">
  <header>
    <div class="brand">Sites <span>On Call</span></div>
    <nav>
      <button data-view="leads" class="active">Leads</button>
      <button data-view="followups">Follow-ups</button>
      <button data-view="dashboard">Dashboard</button>
    </nav>
    <div class="spacer"></div>
    <div class="who" id="whoami"></div>
    <button class="ghost small" id="signOutBtn">Sign out</button>
  </header>

  <main>
    <!-- LEADS LIST -->
    <section id="leadsView">
      <div class="toolbar panel">
        <div class="field grow">
          <label>Search (name, phone, city)</label>
          <input id="fSearch" placeholder="Type to search…" />
        </div>
        <div class="field">
          <label>Stage</label>
          <select id="fStage"></select>
        </div>
        <div class="field">
          <label>City</label>
          <select id="fCity"></select>
        </div>
        <div class="field">
          <label>Industry</label>
          <select id="fIndustry"></select>
        </div>
        <div class="field">
          <label>Website</label>
          <select id="fWebsite">
            <option value="">All</option>
            <option value="none">No website</option>
            <option value="has_site">Has site</option>
            <option value="unknown">Unknown</option>
          </select>
        </div>
        <div class="field">
          <label>Sort</label>
          <select id="fSort">
            <option value="rating_desc">Rating ↓</option>
            <option value="rating_asc">Rating ↑</option>
            <option value="name_asc">Name A–Z</option>
            <option value="updated_desc">Recently updated</option>
          </select>
        </div>
      </div>
      <div id="leadCount" style="color:var(--muted); font-size:13px; margin-bottom:10px;"></div>
      <div id="leadList"></div>
    </section>

    <!-- LEAD DETAIL -->
    <section id="detailView" class="hidden"></section>

    <!-- FOLLOW-UPS -->
    <section id="followupsView" class="hidden">
      <h2 style="margin-top:4px;">Follow-ups due today</h2>
      <p style="color:var(--muted); margin-top:-6px;">Everything due on or before today that isn't done yet.</p>
      <div id="followupList"></div>
    </section>

    <!-- DASHBOARD -->
    <section id="dashboardView" class="hidden">
      <h2 style="margin-top:4px;">Dashboard</h2>
      <div class="stat-grid" id="topStats" style="margin-bottom:20px;"></div>
      <div class="panel" style="margin-bottom:20px;">
        <div class="section-title" style="margin-top:0;">📸 Snapshot queue — needs a one-pager sent</div>
        <div id="snapQueue"></div>
      </div>
      <div class="panel">
        <div class="section-title" style="margin-top:0;">Pipeline by stage</div>
        <div class="stat-grid" id="stageStats"></div>
      </div>
    </section>
  </main>
</div>

<div id="modalRoot"></div>
<div id="toastRoot"></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
/* ===================================================================
   CONFIG  —  Supabase project ref fvnuzyexrzkzugqpzkot.
   The anon key below is the PUBLIC key — safe to ship; RLS protects data.
   (Never put the service_role key here.)
=================================================================== */
const SUPABASE_URL = "https://fvnuzyexrzkzugqpzkot.supabase.co";
const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ2bnV6eWV4cnprenVncXB6a290Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEwODc3MjksImV4cCI6MjA5NjY2MzcyOX0.-K934pgNlMoe3khevOjE_1FCZFLxuDvIE_IBy-Mj3oo";
/* =================================================================== */

const STAGES = ["new","researched","contacted","snapshot_requested","sent_snapshot","discovery","mockup_sent","quoted","won","lost","nurture"];
const STAGE_LABELS = {
  new:"New", researched:"Researched", contacted:"Contacted", snapshot_requested:"Snapshot Requested", sent_snapshot:"Sent Snapshot",
  discovery:"Discovery", mockup_sent:"Mockup Sent", quoted:"Quoted", won:"Won", lost:"Lost", nurture:"Nurture"
};
const STAGE_COLORS = {
  new:"#9aa7c2", researched:"#7aa2ff", contacted:"#4f8cff", snapshot_requested:"#f0883e", sent_snapshot:"#6fb1ff",
  discovery:"#caa0ff", mockup_sent:"#b07cff", quoted:"#e0a73a", won:"#36c08a", lost:"#e2615f", nurture:"#7d8ba6"
};
const OUTCOMES = ["interested","vm_text","callback","not_interested","wrong_number","has_website"];
const OUTCOME_LABELS = {
  interested:"Interested", vm_text:"VM + Text", callback:"Call back",
  not_interested:"Not interested", wrong_number:"Wrong number", has_website:"Has website"
};
const TOUCH_TYPES = ["call","voicemail","text","email","other"];
const TOUCH_LABELS = { call:"Call", voicemail:"Voicemail", text:"Text", email:"Email", other:"Other" };

let sb = null;
let me = null;          // { id, email }
let myProfile = null;   // { full_name, role }
let allLeads = [];      // cached lead list
let currentLead = null;

const $ = (id) => document.getElementById(id);

function toast(msg, kind) {
  const root = $("toastRoot");
  const el = document.createElement("div");
  el.className = "toast " + (kind || "");
  el.textContent = msg;
  root.appendChild(el);
  setTimeout(() => el.remove(), 3200);
}

function esc(s) {
  return String(s == null ? "" : s).replace(/[&<>"']/g, c =>
    ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));
}

function fmtDate(iso) {
  if (!iso) return "";
  const d = new Date(iso);
  return d.toLocaleString(undefined, { month:"short", day:"numeric", hour:"numeric", minute:"2-digit" });
}
function fmtDay(iso) {
  if (!iso) return "";
  const d = new Date(iso + "T00:00:00");
  return d.toLocaleDateString(undefined, { month:"short", day:"numeric", year:"numeric" });
}

/* ---------- boot ---------- */
function init() {
  if (!SUPABASE_ANON_KEY || SUPABASE_ANON_KEY.startsWith("PASTE_")) {
    $("loginError").textContent = "App not configured yet: paste your Supabase anon key into the CONFIG block.";
    $("loginBtn").disabled = true;
    return;
  }
  sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
  sb.auth.getSession().then(({ data }) => {
    if (data.session) onSignedIn(data.session.user);
  });
}

$("loginForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  $("loginError").textContent = "";
  $("loginBtn").disabled = true;
  $("loginBtn").textContent = "Signing in…";
  const email = $("loginEmail").value.trim();
  const password = $("loginPassword").value;
  const { data, error } = await sb.auth.signInWithPassword({ email, password });
  $("loginBtn").disabled = false;
  $("loginBtn").textContent = "Sign in";
  if (error) { $("loginError").textContent = error.message; return; }
  onSignedIn(data.user);
});

$("signOutBtn").addEventListener("click", async () => {
  await sb.auth.signOut();
  location.reload();
});

async function onSignedIn(user) {
  me = { id: user.id, email: user.email };
  $("loginView").classList.add("hidden");
  $("appView").classList.remove("hidden");
  // fetch profile (name + role)
  const { data: prof } = await sb.from("profiles").select("full_name, role").eq("id", user.id).maybeSingle();
  myProfile = prof || { full_name: user.email, role: "caller" };
  $("whoami").textContent = (myProfile.full_name || user.email) + " · " + myProfile.role;
  showView("leads");
  loadLeads();
}

/* ---------- nav ---------- */
document.querySelectorAll("nav button").forEach(b =>
  b.addEventListener("click", () => showView(b.dataset.view)));

function showView(name) {
  document.querySelectorAll("nav button").forEach(b =>
    b.classList.toggle("active", b.dataset.view === name));
  $("leadsView").classList.toggle("hidden", name !== "leads");
  $("detailView").classList.add("hidden");
  $("followupsView").classList.toggle("hidden", name !== "followups");
  $("dashboardView").classList.toggle("hidden", name !== "dashboard");
  if (name === "leads") $("leadsView").classList.remove("hidden");
  if (name === "followups") loadFollowups();
  if (name === "dashboard") loadDashboard();
}

/* ---------- leads ---------- */
["fSearch","fStage","fCity","fIndustry","fWebsite","fSort"].forEach(id =>
  $(id).addEventListener("input", renderLeads));

async function loadLeads() {
  $("leadList").innerHTML = '<div class="empty">Loading leads…</div>';
  const { data, error } = await sb.from("leads")
    .select("id, business_name, industry, phone, email, address, city, state, website_status, website_url, source, stage, rating, website_problem, tags, notes, updated_at")
    .limit(2000);
  if (error) { $("leadList").innerHTML = '<div class="empty">Error: ' + esc(error.message) + '</div>'; return; }
  allLeads = data || [];
  buildFilterOptions();
  renderLeads();
}

function buildFilterOptions() {
  // stage
  const stageSel = $("fStage");
  stageSel.innerHTML = '<option value="">All stages</option>' +
    STAGES.map(s => `<option value="${s}">${STAGE_LABELS[s]}</option>`).join("");
  // city
  const cities = [...new Set(allLeads.map(l => l.city).filter(Boolean))].sort();
  $("fCity").innerHTML = '<option value="">All cities</option>' +
    cities.map(c => `<option value="${esc(c)}">${esc(c)}</option>`).join("");
  // industry
  const inds = [...new Set(allLeads.map(l => l.industry).filter(Boolean))].sort();
  $("fIndustry").innerHTML = '<option value="">All industries</option>' +
    inds.map(i => `<option value="${esc(i)}">${esc(i)}</option>`).join("");
}

function renderLeads() {
  const q = $("fSearch").value.trim().toLowerCase();
  const stage = $("fStage").value;
  const city = $("fCity").value;
  const ind = $("fIndustry").value;
  const web = $("fWebsite").value;
  const sort = $("fSort").value;

  let rows = allLeads.filter(l => {
    if (stage && l.stage !== stage) return false;
    if (city && l.city !== city) return false;
    if (ind && l.industry !== ind) return false;
    if (web && l.website_status !== web) return false;
    if (q) {
      const hay = `${l.business_name} ${l.phone || ""} ${l.city || ""} ${l.industry || ""}`.toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });

  rows.sort((a, b) => {
    if (sort === "rating_desc") return (b.rating || 0) - (a.rating || 0);
    if (sort === "rating_asc")  return (a.rating || 0) - (b.rating || 0);
    if (sort === "name_asc")    return (a.business_name || "").localeCompare(b.business_name || "");
    if (sort === "updated_desc") return new Date(b.updated_at || 0) - new Date(a.updated_at || 0);
    return 0;
  });

  $("leadCount").textContent = `${rows.length} lead${rows.length === 1 ? "" : "s"}`;
  if (!rows.length) { $("leadList").innerHTML = '<div class="empty">No leads match your filters.</div>'; return; }

  $("leadList").innerHTML = rows.map(l => `
    <div class="lead-row" data-id="${l.id}">
      <div class="main">
        <div class="name">${esc(l.business_name)}</div>
        <div class="meta">${esc(l.industry || "—")} · ${esc(l.city || "")}${l.state ? ", " + esc(l.state) : ""} · ${esc(l.phone || "no phone")}</div>
      </div>
      <div class="right">
        <div class="stage-pill" style="color:${STAGE_COLORS[l.stage] || "#9aa7c2"}">${STAGE_LABELS[l.stage] || l.stage}</div>
        <div style="margin-top:4px;">
          ${l.rating ? `<span class="rating">★ ${l.rating}</span>` : ""}
          <span class="badge ${l.website_status === "none" ? "web-none" : l.website_status === "has_site" ? "web-has" : ""}">${l.website_status === "none" ? "No site" : l.website_status === "has_site" ? "Has site" : "?"}</span>
        </div>
      </div>
    </div>`).join("");

  document.querySelectorAll(".lead-row").forEach(r =>
    r.addEventListener("click", () => openLead(r.dataset.id)));
}

/* ---------- lead detail ---------- */
async function openLead(id) {
  currentLead = allLeads.find(l => l.id === id);
  if (!currentLead) return;
  $("leadsView").classList.add("hidden");
  $("followupsView").classList.add("hidden");
  $("dashboardView").classList.add("hidden");
  $("detailView").classList.remove("hidden");
  renderDetail(currentLead, { loading: true });
  // load touches + follow-ups in parallel
  const [touchesRes, fuRes] = await Promise.all([
    sb.from("touches").select("id, touch_type, outcome, notes, occurred_at, legacy_caller, caller_id")
      .eq("lead_id", id).order("occurred_at", { ascending: false }),
    sb.from("follow_ups").select("id, kind, due_date, completed, completed_at, notes")
      .eq("lead_id", id).order("due_date", { ascending: true })
  ]);
  renderDetail(currentLead, { touches: touchesRes.data || [], followups: fuRes.data || [] });
}

function renderDetail(l, opts) {
  opts = opts || {};
  const touches = opts.touches || [];
  const fus = opts.followups || [];
  const v = (x) => x ? esc(x) : '<span style="color:var(--muted)">—</span>';

  let touchHtml = opts.loading ? '<div class="empty">Loading…</div>'
    : (touches.length ? touches.map(t => `
        <div class="touch-item">
          <div class="top">
            <strong>${TOUCH_LABELS[t.touch_type] || t.touch_type}${t.outcome ? " — " + (OUTCOME_LABELS[t.outcome] || t.outcome) : ""}</strong>
            <span class="when">${fmtDate(t.occurred_at)}</span>
          </div>
          ${t.notes ? `<div style="margin-top:5px;font-size:14px;">${esc(t.notes)}</div>` : ""}
          ${t.legacy_caller ? `<div class="when" style="font-size:12px;margin-top:4px;">by ${esc(t.legacy_caller)}</div>` : ""}
        </div>`).join("")
      : '<div class="empty">No calls logged yet.</div>');

  let fuHtml = opts.loading ? ""
    : (fus.length ? fus.map(f => `
        <div class="touch-item" style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
          <div>
            <strong>${esc(f.kind)}</strong> · due ${fmtDay(f.due_date)}
            ${f.completed ? '<span class="badge web-has" style="margin-left:6px;">done</span>' : ''}
            ${f.notes ? `<div style="font-size:13px;color:var(--muted);margin-top:3px;">${esc(f.notes)}</div>` : ""}
          </div>
          ${f.completed ? "" : `<button class="small ghost" onclick="completeFollowup('${f.id}')">Mark done</button>`}
        </div>`).join("")
      : '<div class="empty" style="padding:14px;">No follow-ups scheduled.</div>');

  $("detailView").innerHTML = `
    <button class="ghost small" onclick="backToLeads()">← Back to leads</button>
    <div class="panel" style="margin-top:12px;">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;">
        <div>
          <h2 style="margin:0 0 4px;">${esc(l.business_name)}</h2>
          <div style="color:var(--muted);">${esc(l.industry || "—")} · ${esc(l.city || "")}${l.state ? ", " + esc(l.state) : ""}</div>
        </div>
        <div style="text-align:right;">
          ${l.rating ? `<div class="rating" style="font-size:18px;">★ ${l.rating}</div>` : ""}
          <span class="badge ${l.website_status === "none" ? "web-none" : l.website_status === "has_site" ? "web-has" : ""}">${l.website_status === "none" ? "No website" : l.website_status === "has_site" ? "Has website" : "Unknown"}</span>
        </div>
      </div>

      ${l.website_problem ? `<div class="pitch"><strong>Pitch line:</strong> ${esc(l.website_problem)}</div>` : ""}

      <div class="detail-grid">
        <div><div class="k">Phone</div><div class="v">${l.phone ? `<a href="tel:${esc(l.phone)}">${esc(l.phone)}</a>` : '<span style="color:var(--muted)">—</span>'}</div></div>
        <div><div class="k">Email</div><div class="v">${v(l.email)}</div></div>
        <div><div class="k">Website</div><div class="v">${l.website_url ? `<a href="${esc(l.website_url)}" target="_blank" rel="noopener">${esc(l.website_url)}</a>` : '<span style="color:var(--muted)">—</span>'}</div></div>
        <div><div class="k">Address</div><div class="v">${v(l.address)}</div></div>
        <div><div class="k">Tags</div><div class="v">${l.tags ? esc(l.tags).split("|").map(t=>`<span class="badge" style="margin:2px 2px 0 0;">${esc(t)}</span>`).join("") : '<span style="color:var(--muted)">—</span>'}</div></div>
        <div><div class="k">Source</div><div class="v">${v(l.source)}</div></div>
      </div>
      ${l.notes ? `<div style="margin-top:6px;"><div class="k" style="color:var(--muted);font-size:12px;">Notes</div><div>${esc(l.notes)}</div></div>` : ""}

      <div class="row2" style="margin-top:16px;">
        <div class="field" style="margin:0;">
          <label>Pipeline stage</label>
          <select id="stageSelect">
            ${STAGES.map(s => `<option value="${s}" ${s === l.stage ? "selected" : ""}>${STAGE_LABELS[s]}</option>`).join("")}
          </select>
        </div>
        <div style="display:flex;align-items:end;gap:8px;flex-wrap:wrap;">
          <button onclick="openLogTouch()">＋ Log a touch</button>
          <button class="ghost" onclick="openAddFollowup()">＋ Follow-up</button>
          <button style="background:#f0883e" onclick="requestSnapshot()">📸 Request snapshot</button>
        </div>
      </div>
    </div>

    <div class="section-title">Call history</div>
    <div id="touchHistory">${touchHtml}</div>

    <div class="section-title">Follow-ups</div>
    <div id="fuHistory">${fuHtml}</div>
  `;

  if (!opts.loading) {
    $("stageSelect").addEventListener("change", (e) => moveStage(l.id, e.target.value));
  }
}

function backToLeads() {
  $("detailView").classList.add("hidden");
  $("leadsView").classList.remove("hidden");
}

async function moveStage(leadId, newStage) {
  const { error } = await sb.from("leads").update({ stage: newStage }).eq("id", leadId);
  if (error) { toast("Couldn't update stage: " + error.message, "err"); return; }
  currentLead.stage = newStage;
  const cached = allLeads.find(l => l.id === leadId);
  if (cached) cached.stage = newStage;
  toast("Moved to " + STAGE_LABELS[newStage], "ok");
}

/* ---------- log a touch (modal) ---------- */
let touchDraft = { touch_type: "call", outcome: null };

function openLogTouch() {
  touchDraft = { touch_type: "call", outcome: null };
  $("modalRoot").innerHTML = `
    <div class="modal-bg" onclick="if(event.target===this)closeModal()">
      <div class="modal">
        <h3>Log a touch — ${esc(currentLead.business_name)}</h3>
        <label>Type</label>
        <div class="btn-grid" id="typeGrid">
          ${TOUCH_TYPES.map(t => `<button type="button" data-t="${t}" class="${t==="call"?"sel":""}">${TOUCH_LABELS[t]}</button>`).join("")}
        </div>
        <label>Outcome (optional)</label>
        <div class="btn-grid" id="outcomeGrid" style="grid-template-columns:1fr 1fr;">
          ${OUTCOMES.map(o => `<button type="button" data-o="${o}">${OUTCOME_LABELS[o]}</button>`).join("")}
        </div>
        <div class="field">
          <label>Note (optional)</label>
          <textarea id="touchNote" placeholder="What happened on the call…"></textarea>
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;">
          <button class="ghost" onclick="closeModal()">Cancel</button>
          <button id="saveTouchBtn" onclick="saveTouch()">Save touch</button>
        </div>
      </div>
    </div>`;
  document.querySelectorAll("#typeGrid button").forEach(b => b.addEventListener("click", () => {
    touchDraft.touch_type = b.dataset.t;
    document.querySelectorAll("#typeGrid button").forEach(x => x.classList.toggle("sel", x === b));
  }));
  document.querySelectorAll("#outcomeGrid button").forEach(b => b.addEventListener("click", () => {
    const was = touchDraft.outcome === b.dataset.o;
    touchDraft.outcome = was ? null : b.dataset.o;
    document.querySelectorAll("#outcomeGrid button").forEach(x =>
      x.classList.toggle("sel", !was && x === b));
  }));
}

async function saveTouch() {
  $("saveTouchBtn").disabled = true;
  const note = $("touchNote").value.trim();
  const payload = {
    lead_id: currentLead.id,
    caller_id: me.id,
    touch_type: touchDraft.touch_type,
    outcome: touchDraft.outcome,
    notes: note || null
  };
  const { error } = await sb.from("touches").insert(payload);
  if (error) { toast("Couldn't save: " + error.message, "err"); $("saveTouchBtn").disabled = false; return; }
  closeModal();
  toast("Touch logged", "ok");
  // refresh detail's touch list
  openLead(currentLead.id);
}

/* ---------- add follow-up (modal) ---------- */
function openAddFollowup() {
  const today = new Date();
  const plus3 = new Date(today.getTime() + 3 * 86400000).toISOString().slice(0, 10);
  $("modalRoot").innerHTML = `
    <div class="modal-bg" onclick="if(event.target===this)closeModal()">
      <div class="modal">
        <h3>Schedule a follow-up — ${esc(currentLead.business_name)}</h3>
        <div class="field">
          <label>Kind</label>
          <select id="fuKind">
            <option value="custom">Custom</option>
            <option value="day3">Day 3</option>
            <option value="day7">Day 7</option>
          </select>
        </div>
        <div class="field">
          <label>Due date</label>
          <input type="date" id="fuDate" value="${plus3}" />
        </div>
        <div class="field">
          <label>Note (optional)</label>
          <textarea id="fuNote" placeholder="What to follow up about…"></textarea>
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;">
          <button class="ghost" onclick="closeModal()">Cancel</button>
          <button id="saveFuBtn" onclick="saveFollowup()">Save follow-up</button>
        </div>
      </div>
    </div>`;
}

async function saveFollowup() {
  $("saveFuBtn").disabled = true;
  const payload = {
    lead_id: currentLead.id,
    caller_id: me.id,
    kind: $("fuKind").value,
    due_date: $("fuDate").value,
    notes: $("fuNote").value.trim() || null
  };
  if (!payload.due_date) { toast("Pick a due date", "err"); $("saveFuBtn").disabled = false; return; }
  const { error } = await sb.from("follow_ups").insert(payload);
  if (error) { toast("Couldn't save: " + error.message, "err"); $("saveFuBtn").disabled = false; return; }
  closeModal();
  toast("Follow-up scheduled", "ok");
  openLead(currentLead.id);
}

async function completeFollowup(id) {
  const { error } = await sb.from("follow_ups")
    .update({ completed: true, completed_at: new Date().toISOString() }).eq("id", id);
  if (error) { toast("Couldn't update: " + error.message, "err"); return; }
  toast("Marked done", "ok");
  if (currentLead && !$("detailView").classList.contains("hidden")) openLead(currentLead.id);
  if (!$("followupsView").classList.contains("hidden")) loadFollowups();
}

function closeModal() { $("modalRoot").innerHTML = ""; }

/* ---------- follow-ups due today ---------- */
async function loadFollowups() {
  $("followupList").innerHTML = '<div class="empty">Loading…</div>';
  const today = new Date().toISOString().slice(0, 10);
  const { data, error } = await sb.from("follow_ups")
    .select("id, lead_id, kind, due_date, notes, leads(business_name, phone, city)")
    .eq("completed", false)
    .lte("due_date", today)
    .order("due_date", { ascending: true });
  if (error) { $("followupList").innerHTML = '<div class="empty">Error: ' + esc(error.message) + '</div>'; return; }
  if (!data.length) { $("followupList").innerHTML = '<div class="empty">🎉 Nothing due. Inbox zero on follow-ups.</div>'; return; }
  $("followupList").innerHTML = data.map(f => {
    const lead = f.leads || {};
    const overdue = f.due_date < today;
    return `
      <div class="lead-row" style="cursor:default;">
        <div class="main">
          <div class="name">${esc(lead.business_name || "Lead")}</div>
          <div class="meta">${esc(f.kind)} · due ${fmtDay(f.due_date)}${overdue ? ' <span style="color:var(--red)">(overdue)</span>' : ""} · ${esc(lead.phone || "no phone")}</div>
          ${f.notes ? `<div class="meta">${esc(f.notes)}</div>` : ""}
        </div>
        <div class="right" style="display:flex;gap:6px;">
          <button class="small ghost" onclick="openLead('${f.lead_id}')">Open</button>
          <button class="small" onclick="completeFollowup('${f.id}')">Done</button>
        </div>
      </div>`;
  }).join("");
}

/* ---------- dashboard ---------- */
async function loadDashboard() {
  $("topStats").innerHTML = '<div class="empty" style="grid-column:1/-1;">Loading…</div>';
  $("stageStats").innerHTML = "";
  if ($("snapQueue")) $("snapQueue").innerHTML = '<div class="empty" style="padding:14px;">Loading…</div>';

  // make sure we have full lead data (also powers the snapshot queue's Open button)
  if (!allLeads.length) await loadLeads();
  const leads = allLeads;

  const byStage = {};
  STAGES.forEach(s => byStage[s] = 0);
  leads.forEach(l => { if (byStage[l.stage] != null) byStage[l.stage]++; });
  const total = leads.length;

  // touches in last 30 days (count via head request)
  const since = new Date(Date.now() - 30 * 86400000).toISOString();
  const { count: touches30 } = await sb.from("touches")
    .select("id", { count: "exact", head: true })
    .gte("occurred_at", since);

  // follow-ups due today
  const today = new Date().toISOString().slice(0, 10);
  const { count: dueCount } = await sb.from("follow_ups")
    .select("id", { count: "exact", head: true })
    .eq("completed", false).lte("due_date", today);

  $("topStats").innerHTML = `
    <div class="stat"><div class="num">${total}</div><div class="lbl">Total leads</div></div>
    <div class="stat"><div class="num">${touches30 ?? "—"}</div><div class="lbl">Touches · 30d</div></div>
    <div class="stat"><div class="num" style="color:var(--green)">${byStage.won}</div><div class="lbl">Won</div></div>
    <div class="stat"><div class="num" style="color:var(--amber)">${dueCount ?? "—"}</div><div class="lbl">Follow-ups due</div></div>
  `;

  $("stageStats").innerHTML = STAGES.map(s => `
    <div class="stat">
      <div class="num" style="color:${STAGE_COLORS[s]}">${byStage[s]}</div>
      <div class="lbl">${STAGE_LABELS[s]}</div>
    </div>`).join("");

  // ---- snapshot queue: leads flagged "needs a one-pager" ----
  try {
    const { data: snaps, error: snapErr } = await sb.from("leads")
      .select("id, business_name, industry, phone, email, address, city, state, website_status, website_url, source, stage, rating, website_problem, tags, notes, updated_at")
      .eq("stage", "snapshot_requested")
      .order("updated_at", { ascending: true });
    if (snapErr) throw snapErr;
    // merge into the cache so the Open button always finds them
    (snaps || []).forEach(s => {
      const i = allLeads.findIndex(l => l.id === s.id);
      if (i === -1) allLeads.push(s); else allLeads[i] = s;
    });
    if (!snaps || !snaps.length) {
      $("snapQueue").innerHTML = '<div class="empty" style="padding:14px;">No snapshots waiting. All caught up.</div>';
    } else {
      $("snapQueue").innerHTML = snaps.map(s => `
        <div class="lead-row" style="cursor:default;">
          <div class="main">
            <div class="name">${esc(s.business_name)}</div>
            <div class="meta">${esc(s.city || "")} · ${esc(s.phone || "no phone")}</div>
            ${s.website_problem ? `<div class="meta">${esc(s.website_problem)}</div>` : ""}
          </div>
          <div class="right" style="display:flex;gap:6px;">
            <button class="small ghost" onclick="openLead('${s.id}')">Open</button>
            <button class="small" onclick="markSnapshotSent('${s.id}')">Mark sent</button>
          </div>
        </div>`).join("");
    }
  } catch (e) {
    $("snapQueue").innerHTML = '<div class="empty" style="padding:14px;">Queue activates once the “Snapshot Requested” stage is added in Supabase (run the one-line SQL).</div>';
  }
}

/* ---------- snapshot request / mark sent ---------- */
async function requestSnapshot() {
  const { error } = await sb.from("leads").update({ stage: "snapshot_requested" }).eq("id", currentLead.id);
  if (error) { toast("Couldn't request snapshot: " + error.message, "err"); return; }
  currentLead.stage = "snapshot_requested";
  const cached = allLeads.find(l => l.id === currentLead.id);
  if (cached) cached.stage = "snapshot_requested";
  toast("📸 Snapshot requested — it'll show in the queue", "ok");
  openLead(currentLead.id);
}
async function markSnapshotSent(id) {
  const { error } = await sb.from("leads").update({ stage: "sent_snapshot" }).eq("id", id);
  if (error) { toast("Couldn't update: " + error.message, "err"); return; }
  const cached = allLeads.find(l => l.id === id);
  if (cached) cached.stage = "sent_snapshot";
  toast("Marked snapshot sent", "ok");
  loadDashboard();
}

/* expose handlers used in inline onclick */
window.backToLeads = backToLeads;
window.openLogTouch = openLogTouch;
window.saveTouch = saveTouch;
window.openAddFollowup = openAddFollowup;
window.saveFollowup = saveFollowup;
window.completeFollowup = completeFollowup;
window.closeModal = closeModal;
window.openLead = openLead;
window.requestSnapshot = requestSnapshot;
window.markSnapshotSent = markSnapshotSent;

init();
</script>
</body>
</html>
{% endraw %}

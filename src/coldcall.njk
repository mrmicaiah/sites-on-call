layout: layouts/base.njk
title: Cold Call Tool — Sites On Call
noindex: true
eleventyExcludeFromCollections: true
---
{% raw %}
<style>
  /* ===== Cold Call Tool — scoped styles ===== */
  :root{
    --cc-navy:#0a2540; --cc-navy2:#0f3050; --cc-ink:#0a2540;
    --cc-paper:#f4f6f9; --cc-card:#ffffff; --cc-line:#e2e8f0;
    --cc-slate:#475569; --cc-muted:#94a3b8;
    --cc-green:#16a34a; --cc-green-d:#15803d;
    --cc-red:#dc2626; --cc-amber:#d97706; --cc-blue:#2563eb;
    --cc-hot:#dc2626; --cc-warm:#d97706; --cc-luke:#0891b2;
  }
  body{ background:var(--cc-paper); }
  main{ }
  .cc-wrap{ max-width:560px; margin:0 auto; padding:0 16px 140px; font-family:'Outfit',system-ui,sans-serif; }

  /* ---- Password gate ---- */
  .cc-gate{ position:fixed; inset:0; z-index:9999; background:var(--cc-navy);
    display:flex; align-items:center; justify-content:center; padding:24px; }
  .cc-gate-card{ background:#fff; border-radius:18px; padding:32px 26px; width:100%; max-width:360px;
    box-shadow:0 20px 60px rgba(0,0,0,.35); text-align:center; }
  .cc-gate-card h1{ font-family:'DM Serif Display',Georgia,serif; color:var(--cc-navy); font-size:1.5rem; margin:0 0 4px; }
  .cc-gate-card p{ color:var(--cc-slate); font-size:.92rem; margin:0 0 20px; }
  .cc-gate-card input{ width:100%; padding:14px 16px; font-size:1.05rem; border:2px solid var(--cc-line);
    border-radius:12px; text-align:center; letter-spacing:.04em; outline:none; box-sizing:border-box; }
  .cc-gate-card input:focus{ border-color:var(--cc-navy); }
  .cc-gate-card button{ width:100%; margin-top:14px; padding:14px; font-size:1.05rem; font-weight:600;
    background:var(--cc-navy); color:#fff; border:0; border-radius:12px; cursor:pointer; }
  .cc-gate-err{ color:var(--cc-red); font-size:.86rem; min-height:1.1em; margin-top:10px; font-weight:500; }
  .cc-hidden{ display:none !important; }

  /* ---- Header / counts ---- */
  .cc-head{ position:sticky; top:0; z-index:50; background:var(--cc-paper);
    padding:16px 0 10px; border-bottom:1px solid var(--cc-line); margin-bottom:14px; }
  .cc-title{ font-family:'DM Serif Display',Georgia,serif; color:var(--cc-navy); font-size:1.35rem; margin:0 0 2px; }
  .cc-counts{ display:flex; gap:14px; flex-wrap:wrap; font-size:.84rem; color:var(--cc-slate); font-weight:500; }
  .cc-counts b{ color:var(--cc-navy); font-weight:700; }
  .cc-counts .cc-good b{ color:var(--cc-green-d); }

  /* ---- Filter chips ---- */
  .cc-filters{ display:flex; gap:8px; overflow-x:auto; padding:10px 0 4px; -webkit-overflow-scrolling:touch; }
  .cc-filters::-webkit-scrollbar{ display:none; }
  .cc-chip{ flex:0 0 auto; padding:8px 14px; border-radius:999px; border:1.5px solid var(--cc-line);
    background:#fff; color:var(--cc-slate); font-size:.86rem; font-weight:600; cursor:pointer; white-space:nowrap; }
  .cc-chip.cc-active{ background:var(--cc-navy); color:#fff; border-color:var(--cc-navy); }

  /* ---- Lead card ---- */
  .cc-card{ background:var(--cc-card); border:1px solid var(--cc-line); border-radius:18px;
    padding:20px; box-shadow:0 4px 18px rgba(10,37,64,.06); }
  .cc-meta{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:6px; }
  .cc-pill{ font-size:.74rem; font-weight:700; padding:3px 10px; border-radius:999px; background:#eef2f7; color:var(--cc-slate); }
  .cc-pill.cc-city{ background:#e7eef7; color:var(--cc-navy); }
  .cc-pill.cc-rate{ background:#fff7e6; color:var(--cc-amber); }
  .cc-biz{ font-family:'DM Serif Display',Georgia,serif; font-size:1.5rem; color:var(--cc-navy); margin:6px 0 2px; line-height:1.15; }
  .cc-prob{ color:var(--cc-slate); font-size:.95rem; line-height:1.5; margin:10px 0 4px;
    background:#fff5f5; border-left:3px solid var(--cc-red); padding:10px 12px; border-radius:0 8px 8px 0; }
  .cc-site{ font-size:.85rem; margin:10px 0 0; word-break:break-all; }
  .cc-site a{ color:var(--cc-blue); }
  .cc-nosite{ font-size:.85rem; color:var(--cc-red); font-weight:600; margin-top:10px; }

  /* ---- Call button ---- */
  .cc-call{ display:flex; align-items:center; justify-content:center; gap:10px; width:100%;
    margin:18px 0 4px; padding:18px; font-size:1.25rem; font-weight:700; color:#fff;
    background:var(--cc-green); border-radius:14px; text-decoration:none; box-shadow:0 6px 16px rgba(22,163,74,.3); }
  .cc-call:active{ transform:translateY(1px); }
  .cc-call.cc-disabled{ background:var(--cc-muted); box-shadow:none; pointer-events:none; }
  .cc-call svg{ width:22px; height:22px; }

  /* ---- Result buttons ---- */
  .cc-results{ display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:16px; }
  .cc-rbtn{ padding:15px 10px; font-size:.98rem; font-weight:600; border:0; border-radius:12px;
    cursor:pointer; color:#fff; }
  .cc-rbtn:active{ transform:translateY(1px); }
  .cc-good-btn{ background:var(--cc-green); grid-column:1 / -1; font-size:1.05rem; }
  .cc-vm{ background:#475569; } .cc-cb{ background:var(--cc-blue); }
  .cc-na{ background:#64748b; } .cc-ni{ background:var(--cc-amber); }
  .cc-dnc{ background:var(--cc-red); }

  /* ---- progress / nav ---- */
  .cc-progress{ text-align:center; color:var(--cc-muted); font-size:.84rem; margin:16px 0 0; }
  .cc-skipbar{ display:flex; justify-content:space-between; margin-top:14px; }
  .cc-skip{ background:none; border:0; color:var(--cc-slate); font-size:.9rem; font-weight:600; cursor:pointer; padding:6px 4px; }
  .cc-skip:disabled{ color:var(--cc-line); cursor:default; }

  .cc-empty{ text-align:center; padding:60px 20px; color:var(--cc-slate); }
  .cc-empty h2{ font-family:'DM Serif Display',Georgia,serif; color:var(--cc-navy); }
  .cc-reset{ margin-top:18px; background:var(--cc-navy); color:#fff; border:0; border-radius:10px; padding:10px 18px; font-weight:600; cursor:pointer; }

  /* ---- Scorecard bottom sheet ---- */
  .cc-sheet-ov{ position:fixed; inset:0; z-index:9998; background:rgba(10,37,64,.55);
    display:flex; align-items:flex-end; justify-content:center; }
  .cc-sheet{ background:#fff; width:100%; max-width:560px; border-radius:20px 20px 0 0;
    max-height:92vh; overflow-y:auto; padding:22px 20px calc(22px + env(safe-area-inset-bottom)); }
  .cc-sheet h2{ font-family:'DM Serif Display',Georgia,serif; color:var(--cc-navy); font-size:1.4rem; margin:0 0 2px; }
  .cc-sheet .cc-sub{ color:var(--cc-slate); font-size:.9rem; margin:0 0 16px; }
  .cc-field{ margin-bottom:14px; }
  .cc-field label{ display:block; font-size:.82rem; font-weight:700; color:var(--cc-navy); margin-bottom:6px; }
  .cc-field .cc-hint{ font-weight:400; color:var(--cc-muted); }
  .cc-field input, .cc-field textarea, .cc-field select{ width:100%; padding:13px 14px; font-size:1rem;
    border:1.5px solid var(--cc-line); border-radius:11px; box-sizing:border-box; font-family:inherit; outline:none; }
  .cc-field input:focus, .cc-field textarea:focus, .cc-field select:focus{ border-color:var(--cc-navy); }
  .cc-field input.cc-star{ border-color:var(--cc-green); background:#f0fdf4; }
  .cc-seg{ display:flex; gap:8px; }
  .cc-seg button{ flex:1; padding:12px 6px; font-size:.92rem; font-weight:600; border:1.5px solid var(--cc-line);
    background:#fff; color:var(--cc-slate); border-radius:11px; cursor:pointer; }
  .cc-seg button.cc-sel-hot{ background:var(--cc-hot); color:#fff; border-color:var(--cc-hot); }
  .cc-seg button.cc-sel-warm{ background:var(--cc-warm); color:#fff; border-color:var(--cc-warm); }
  .cc-seg button.cc-sel-luke{ background:var(--cc-luke); color:#fff; border-color:var(--cc-luke); }
  .cc-seg button.cc-sel-plain{ background:var(--cc-navy); color:#fff; border-color:var(--cc-navy); }
  .cc-tags{ display:flex; flex-wrap:wrap; gap:8px; }
  .cc-tag{ padding:9px 13px; font-size:.86rem; font-weight:600; border:1.5px solid var(--cc-line);
    background:#fff; color:var(--cc-slate); border-radius:999px; cursor:pointer; }
  .cc-tag.cc-on{ background:var(--cc-navy); color:#fff; border-color:var(--cc-navy); }
  .cc-sheet-actions{ display:flex; gap:10px; margin-top:8px; position:sticky; bottom:0; background:#fff; padding:12px 0 0; }
  .cc-cancel{ flex:0 0 auto; padding:15px 18px; background:#eef2f7; color:var(--cc-slate); border:0; border-radius:12px; font-weight:600; font-size:1rem; cursor:pointer; }
  .cc-save{ flex:1; padding:15px; background:var(--cc-green); color:#fff; border:0; border-radius:12px; font-weight:700; font-size:1.05rem; cursor:pointer; }
  .cc-save.cc-saving{ background:var(--cc-muted); }
  .cc-savemsg{ font-size:.82rem; text-align:center; margin-top:8px; min-height:1em; }
  .cc-savemsg.cc-ok{ color:var(--cc-green-d); } .cc-savemsg.cc-bad{ color:var(--cc-red); }

  /* ---- Tab bar ---- */
  .cc-tabs{ display:flex; gap:6px; margin:10px 0 0; background:#e7eef7; padding:4px; border-radius:12px; }
  .cc-tab{ flex:1; padding:10px; font-size:.92rem; font-weight:700; border:0; background:transparent;
    color:var(--cc-slate); border-radius:9px; cursor:pointer; }
  .cc-tab.cc-tab-on{ background:#fff; color:var(--cc-navy); box-shadow:0 1px 3px rgba(10,37,64,.12); }

  /* ---- History view ---- */
  .cc-search{ width:100%; padding:13px 15px; font-size:1rem; border:1.5px solid var(--cc-line);
    border-radius:12px; box-sizing:border-box; margin:14px 0 6px; outline:none; }
  .cc-search:focus{ border-color:var(--cc-navy); }
  .cc-hsection{ font-size:.8rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em;
    color:var(--cc-muted); margin:18px 0 8px; }
  .cc-hrow{ background:#fff; border:1px solid var(--cc-line); border-radius:14px; padding:14px 16px; margin-bottom:10px; }
  .cc-hrow.cc-cb-row{ border-left:4px solid var(--cc-blue); }
  .cc-hrow-top{ display:flex; justify-content:space-between; align-items:flex-start; gap:10px; }
  .cc-hbiz{ font-weight:700; color:var(--cc-navy); font-size:1.05rem; line-height:1.2; }
  .cc-hmeta{ font-size:.8rem; color:var(--cc-muted); margin-top:2px; }
  .cc-badge{ flex:0 0 auto; font-size:.72rem; font-weight:700; padding:4px 10px; border-radius:999px; white-space:nowrap; }
  .cc-b-good{ background:#dcfce7; color:var(--cc-green-d); } .cc-b-callback{ background:#dbeafe; color:#1d4ed8; }
  .cc-b-vm{ background:#e2e8f0; color:#475569; } .cc-b-noanswer{ background:#f1f5f9; color:#64748b; }
  .cc-b-notint{ background:#fef3c7; color:#b45309; } .cc-b-dnc{ background:#fee2e2; color:#b91c1c; }
  .cc-hnotes{ font-size:.86rem; color:var(--cc-slate); margin-top:8px; line-height:1.45;
    background:#f8fafc; border-radius:8px; padding:8px 10px; }
  .cc-hactions{ display:flex; gap:8px; margin-top:12px; flex-wrap:wrap; }
  .cc-ha{ flex:1; min-width:90px; padding:11px 8px; font-size:.88rem; font-weight:600; border:0;
    border-radius:10px; cursor:pointer; text-decoration:none; text-align:center; }
  .cc-ha-call{ background:var(--cc-green); color:#fff; } .cc-ha-call.cc-disabled{ background:var(--cc-muted); pointer-events:none; }
  .cc-ha-edit{ background:#eef2f7; color:var(--cc-navy); } .cc-ha-reopen{ background:var(--cc-navy); color:#fff; }
  .cc-hempty{ text-align:center; color:var(--cc-muted); padding:40px 20px; font-size:.95rem; }
  .cc-resetwrap{ text-align:center; margin-top:28px; padding-top:18px; border-top:1px solid var(--cc-line); }
  .cc-resetwrap button{ background:none; border:0; color:var(--cc-red); font-size:.85rem; font-weight:600; cursor:pointer; text-decoration:underline; }

  /* ---- Call scripts on card ---- */
  .cc-script{ margin:14px 0 4px; }
  .cc-script-label{ font-size:.74rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em;
    color:var(--cc-navy); margin:0 0 6px; display:flex; align-items:center; gap:6px; }
  .cc-script-body{ background:#eef5ff; border-left:3px solid var(--cc-blue); border-radius:0 10px 10px 0;
    padding:12px 14px; font-size:.97rem; line-height:1.55; color:#1e293b; }
  .cc-script-body .ph{ background:#dbeafe; color:#1d4ed8; font-weight:700; padding:0 4px; border-radius:4px; }
  .cc-vmtoggle{ margin-top:10px; width:100%; text-align:left; background:#f1f5f9; border:0; cursor:pointer;
    padding:11px 14px; border-radius:10px; font-size:.9rem; font-weight:700; color:var(--cc-navy);
    display:flex; justify-content:space-between; align-items:center; }
  .cc-vmtoggle .cc-caret{ transition:transform .15s; }
  .cc-vmtoggle.cc-open .cc-caret{ transform:rotate(180deg); }
  .cc-vmbody{ margin-top:8px; }
  .cc-vmbody.cc-collapsed{ display:none; }
  .cc-mini{ margin-top:10px; }
  .cc-mini-label{ font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em;
    color:var(--cc-slate); margin:0 0 4px; }
  .cc-mini-body{ background:#f8fafc; border:1px solid var(--cc-line); border-radius:9px;
    padding:9px 12px; font-size:.9rem; line-height:1.5; color:var(--cc-slate); margin-bottom:6px; }
</style>

<!-- ===== PASSWORD GATE ===== -->
<div class="cc-gate" id="ccGate">
  <div class="cc-gate-card">
    <h1>Sites On Call</h1>
    <p>Caller access</p>
    <input type="password" id="ccPass" placeholder="Password" autocomplete="off" inputmode="text">
    <button id="ccPassBtn">Enter</button>
    <div class="cc-gate-err" id="ccGateErr"></div>
  </div>
</div>

<!-- ===== TOOL ===== -->
<div class="cc-wrap cc-hidden" id="ccApp">
  <div class="cc-head">
    <div class="cc-title">Call List</div>
    <div class="cc-counts">
      <span>Left: <b id="ccLeft">0</b></span>
      <span>Done: <b id="ccDone">0</b></span>
      <span class="cc-good">Good: <b id="ccGoodCount">0</b></span>
    </div>
    <div class="cc-tabs">
      <button class="cc-tab cc-tab-on" id="ccTabQueue">Queue</button>
      <button class="cc-tab" id="ccTabHistory">History</button>
    </div>
    <div class="cc-filters" id="ccFilters"></div>
  </div>

  <div id="ccStage"></div>
  <div class="cc-progress" id="ccProgress"></div>

  <div id="ccHistory" class="cc-hidden"></div>
</div>


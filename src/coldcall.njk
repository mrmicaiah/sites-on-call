function ccSaveManualContact(f){
  // a totally empty form is a no-op (don't litter the queue/sheet with blanks)
  if(!f.business && !f.contact && !f.phone && !f.email && !f.note){
    ccToast('Nothing to add \u2014 fill in at least one field', 'warn');
    return;
  }
  const lead = ccMakeManualLead({
    business:f.business, contact:f.contact, phone:f.phone,
    email:f.email, trade:f.trade, city:f.city, note:f.note
  });
  if(!ccState.manual) ccState.manual={};
  ccState.manual[lead.id] = lead;
  CC_LEADS.push(lead);

  // Wire into the EXISTING date-based pending model so it surfaces in the Queue
  // on its callback date. nextAction 'callback' or 'text' reuses the live flags.
  if(!ccState.pending) ccState.pending={};
  const due = (f.due && /^\d{4}-\d{2}-\d{2}$/.test(f.due)) ? f.due : ccTodayKey();
  ccState.pending[lead.id] = { id:lead.id, nextAction:(f.mode==='text'?'text':'callback'), due:due };

  // a record so it appears in History too
  if(!ccState.recs) ccState.recs={};
  ccState.recs[lead.id] = { id:lead.id, result:(f.mode==='text'?'manual-text':'manual-callback'),
    when:new Date().toLocaleString('en-US',{timeZone:'America/Chicago'}),
    notes:(f.note||'') };
  saveState();

  // Write an immediately-visible row to the outcome-log tab (the row Irene asked
  // for). This is the existing outcome doPost path — NOT an event — stamped
  // source:'Manual Add'. Fire-and-forget (no-cors); we can't confirm receipt.
  try{
    if(CC_SHEET_URL && CC_SHEET_URL.indexOf('__SHEET')<0){
      const payload = {
        date: new Date().toLocaleString('en-US',{timeZone:'America/Chicago'}),
        business: f.business||'', contact: f.contact||'', phone: f.phone||'',
        email: f.email||'', trade: f.trade||'', city: f.city||'',
        followUp: due, notes: f.note||'',
        status: 'Manual add \u2014 '+(f.mode==='text'?'text':'call')+' due '+due,
        source: 'Manual Add'
      };
      fetch(CC_SHEET_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(payload)}).catch(()=>{});
    }
  }catch(e){}

  buildFilters();
  const label = f.business || f.contact || 'Contact';
  ccToast('✓ Added \u201c'+label+'\u201d \u2014 due '+ccFmtDue(due), 'ok');
  switchView('queue');
}

function ccTryPass(){
  const v = document.getElementById('ccPass').value.trim();
  if(v === CC_PASSWORD){ ccUnlock(); }
  else { document.getElementById('ccGateErr').textContent = "Nope, try again."; }
}
document.getElementById('ccPassBtn').addEventListener('click', ccTryPass);
document.getElementById('ccPass').addEventListener('keydown', e=>{ if(e.key==='Enter') ccTryPass(); });
try{ if((localStorage.getItem('soc_cc_ok')==='1') || (sessionStorage.getItem('soc_cc_ok')==='1')) ccUnlock(); }catch(e){}

/* ============ APP ============ */
function activeLeads(){
  return CC_LEADS.filter(l => !(l.id in ccState.done) && !(ccState.pending && l.id in ccState.pending))
                 .filter(l => ccState.filter==="All" || l.c===ccState.filter)
                 .filter(l => {
                    if(!ccQSearch) return true;
                    // name match (as before)
                    if(l.b.toLowerCase().includes(ccQSearch)) return true;
                    // phone match: if the search has any digits, compare digits-only
                    let qDigits = ccQSearch.replace(/\D/g,'');
                    if(qDigits.length===11 && qDigits[0]==='1') qDigits = qDigits.slice(1); // drop leading country code
                    if(qDigits){ const pDigits = (l.p||'').replace(/\D/g,''); if(pDigits && pDigits.includes(qDigits)) return true; }
                    return false;
                 });
}
function cityCounts(){
  const m = {};
  CC_LEADS.forEach(l=>{ if(!(l.id in ccState.done) && !(ccState.pending && l.id in ccState.pending)) m[l.c]=(m[l.c]||0)+1; });
  return m;
}
function initApp(){
  ccSetupMuteToggle();
  document.getElementById('ccTabQueue').addEventListener('click', ()=>switchView('queue'));
  document.getElementById('ccTabHistory').addEventListener('click', ()=>switchView('history'));
  document.getElementById('ccTabBackup').addEventListener('click', ccBackup);
  document.getElementById('ccTabAdd').addEventListener('click', ccOpenAddContact);
  buildFilters();
  ccCursor = 0;
  switchView('queue');
}
function switchView(v){
  ccView = v;
  const isQ = v==='queue';
  document.getElementById('ccTabQueue').classList.toggle('cc-tab-on', isQ);
  document.getElementById('ccTabHistory').classList.toggle('cc-tab-on', !isQ);
  document.getElementById('ccStage').classList.toggle('cc-hidden', !isQ);
  document.getElementById('ccProgress').classList.toggle('cc-hidden', !isQ);
  document.getElementById('ccFilters').classList.toggle('cc-hidden', !isQ);
  document.getElementById('ccHistory').classList.toggle('cc-hidden', isQ);
  if(isQ){ render(); } else { renderHistory(); }
}
function buildFilters(){
  const wrap = document.getElementById('ccFilters');
  const counts = cityCounts();
  const cities = Object.keys(counts).sort();
  const total = Object.values(counts).reduce((a,b)=>a+b,0);
  let html = chipHtml("All", total, ccState.filter==="All");
  cities.forEach(c=> html += chipHtml(c, counts[c], ccState.filter===c));
  wrap.innerHTML = html;
  [...wrap.querySelectorAll('.cc-chip')].forEach(ch=>{
    ch.addEventListener('click', ()=>{ ccState.filter = ch.dataset.city; ccCursor=0; saveState(); buildFilters(); render(); });
  });
}
function chipHtml(city, n, active){
  return '<button class="cc-chip'+(active?' cc-active':'')+'" data-city="'+esc(city)+'">'+esc(city)+' ('+n+')</button>';
}
function updateCounts(){
  const doneN = Object.keys(ccState.done).length;
  const goodN = Object.values(ccState.done).filter(r=>r==="good").length;
  document.getElementById('ccDone').textContent = doneN;
  document.getElementById('ccGoodCount').textContent = goodN;
  // "Left" shows TRUE fresh remaining, ignoring the queue search filter
  const trueFresh = CC_LEADS.filter(l => !(l.id in ccState.done) && !(ccState.pending && l.id in ccState.pending)).length;
  document.getElementById('ccLeft').textContent = trueFresh;
}
function render(){
  updateCounts();
  renderDuePanel();
  renderQSearch();
  const list = activeLeads();
  const stage = document.getElementById('ccStage');
  const prog = document.getElementById('ccProgress');
  if(list.length===0){
    const msg = ccQSearch ? ('No fresh leads match \u201c'+esc(ccQSearch)+'\u201d.') : ('No fresh leads left'+(ccState.filter!=="All"?(' in '+esc(ccState.filter)):'')+'.');
    stage.innerHTML = '<div class="cc-empty"><h2>'+(ccQSearch?'No match':'All caught up 🎉')+'</h2><p>'+msg+'</p>'+(ccQSearch?'':'<button class="cc-reset" id="ccResetBtn">Reset all progress</button>')+'</div>';
    prog.textContent='';
    const rb=document.getElementById('ccResetBtn'); if(rb) rb.addEventListener('click', ccReset);
    return;
  }
  if(ccCursor >= list.length) ccCursor = 0;
  if(ccCursor < 0) ccCursor = list.length-1;
  const l = list[ccCursor];
  stage.innerHTML = cardHtml(l);
  prog.textContent = 'Card '+(ccCursor+1)+' of '+list.length;
  wireCard(l, list.length);
}
/* ===== queue search box (mirrors History search styling) ===== */
function renderQSearch(){
  let box = document.getElementById('ccQSearchWrap');
  const stage = document.getElementById('ccStage');
  if(!box){
    box = document.createElement('div');
    box.id = 'ccQSearchWrap';
    box.innerHTML = '<input class="cc-search" id="ccQSearchInput" type="text" placeholder="Search by business name or phone number…">';
    stage.parentNode.insertBefore(box, stage);
    const inp = document.getElementById('ccQSearchInput');
    inp.addEventListener('input', e=>{
      ccQSearch = e.target.value.trim().toLowerCase();
      const pos = e.target.selectionStart;
      ccCursor = 0; render();
      const ni = document.getElementById('ccQSearchInput');
      if(ni){ ni.focus(); try{ ni.setSelectionRange(pos,pos); }catch(_){ } }
    });
  }
  const inp = document.getElementById('ccQSearchInput');
  if(inp && inp.value !== ccQSearch && document.activeElement!==inp){ inp.value = ccQSearch; }
}
/* ===== due-today follow-up panel ===== */
function renderDuePanel(){
  let panel = document.getElementById('ccDuePanel');
  const stage = document.getElementById('ccStage');
  if(!panel){
    panel = document.createElement('div');
    panel.id = 'ccDuePanel';
    stage.parentNode.insertBefore(panel, stage);
  }
  const due = ccDueToday();
  if(due.length===0){ panel.innerHTML=''; return; }
  const flag = { text:['cc-flag-text','📲 Send text'], 'text-noans':['cc-flag-text','📲 Send text'], finaltext:['cc-flag-final','📲 Send FINAL text'], callback:['cc-flag-cb','📞 Call back'] };
  const why  = { text:'voicemail left — text today', 'text-noans':'no answer — text today', finaltext:'first text sent — final text today', callback:'asked for a call back' };
  let rows = '';
  due.forEach(l=>{
    const p = ccState.pending[l.id]; const f = flag[p.nextAction]||flag.text;
    rows += '<div class="cc-duerow" data-due-id="'+l.id+'">'+
      '<span class="cc-dueflag '+f[0]+'">'+f[1]+'</span>'+
      '<div class="cc-dueinfo"><div class="cc-duebiz">'+esc(l.b)+'</div>'+
        '<div class="cc-duemeta">'+esc(l.c)+' · '+esc(l.t)+' · '+(why[p.nextAction]||'')+'</div></div>'+
      '<button class="cc-dueopen" data-due-id="'+l.id+'">Open ›</button></div>';
  });
  panel.innerHTML = '<div class="cc-duehead">⏰ Due today — do these first ('+due.length+')</div>'+
    '<div class="cc-duelist">'+rows+'</div>';
  [...panel.querySelectorAll('.cc-dueopen')].forEach(b=>{
    b.addEventListener('click', ()=>{ const l=CC_LEADS.find(x=>String(x.id)===String(b.dataset.dueId)); if(l) openFollowUp(l); });

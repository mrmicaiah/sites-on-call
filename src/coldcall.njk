/* ===== PHASE 2: reconcile local progress with the Sheet on boot =====
   Durability payoff: if this browser was cleared (local empty) but the Sheet
   has events, adopt the Sheet's progress so nothing is lost. If local already
   has progress, keep local (it's the live source of truth during a shift) —
   the Sheet is the mirror, not the master, for an active browser. Always
   proceeds to `done()` even if the fetch fails, so a network hiccup never
   blocks Gloria from working off her local copy. */
function ccReconcileProgress(done){
  const localDone = Object.keys((ccState&&ccState.done)||{}).length;
  const localPend = Object.keys((ccState&&ccState.pending)||{}).length;
  const localCount = localDone + localPend;
  const url = CC_SHEET_URL + (CC_SHEET_URL.indexOf('?')<0?'?':'&') + 'progress=1&_=' + Date.now();
  let settled = false;
  const finish = ()=>{ if(settled) return; settled=true; done(); };
  // safety timeout: never hang the app on a slow Apps Script call
  const t = setTimeout(finish, 8000);
  fetch(url, { method:'GET' })
    .then(r=>r.json())
    .then(data=>{
      if(data && data.ok && data.state){
        const sheetDone = Object.keys(data.state.done||{}).length;
        const sheetPend = Object.keys(data.state.pending||{}).length;
        // Adopt the Sheet ONLY when local is empty/blank (e.g. cleared browser).
        // An active browser with its own progress keeps local — we don't let a
        // stale Sheet read clobber a live shift.
        if(localCount === 0 && (sheetDone + sheetPend) > 0){
          ccState.done = data.state.done || {};
          ccState.recs = data.state.recs || {};
          ccState.pending = data.state.pending || {};
          saveState();
          ccToast('✓ Restored '+sheetDone+' calls from the cloud', 'ok');
        }
      }
    })
    .catch(()=>{})
    .finally(()=>{ clearTimeout(t); finish(); });
}

/* ===== Load the lead list live from the Leads tab (Google Apps Script doGet) =====
   The 461 leads are no longer baked into this file — they live in the Sheet so they
   can be edited without a code change. ccState (Gloria's progress) still loads from
   localStorage and is keyed by lead id, so ids must stay aligned with the Sheet. */
function ccBootLeads(){
  const stage = document.getElementById('ccStage');
  if(stage) stage.innerHTML = '<div class="cc-empty"><h2>Loading leads…</h2><p>Pulling the list from Google. One sec.</p></div>';
  // cache-bust so an edited Sheet shows up without a hard refresh
  const url = CC_SHEET_URL + (CC_SHEET_URL.indexOf('?')<0?'?':'&') + 'leads=1&_=' + Date.now();
  fetch(url, { method:'GET' })
    .then(r => r.json())
    .then(data => {
      if(!data || data.ok !== true || !Array.isArray(data.leads)) throw new Error('bad payload');
      CC_LEADS = data.leads;
      // belt-and-suspenders: keep ids numeric and the list in id order
      CC_LEADS.forEach(l=>{ l.id = Number(l.id); });
      CC_LEADS.sort((a,b)=> a.id - b.id);
      ccRehydrateManual();           // merge Gloria's manually-added contacts back in
      ccReconcileProgress(initApp);  // pull Sheet progress, then start
    })
    .catch(err => {
      if(stage) stage.innerHTML = '<div class="cc-empty"><h2>Couldn\u2019t load leads</h2>'
        + '<p>The lead list didn\u2019t come back from Google. Your saved progress is safe \u2014 this is just the list of who to call.</p>'
        + '<button class="cc-reset" id="ccRetryBtn">Try again</button></div>';
      const rb=document.getElementById('ccRetryBtn'); if(rb) rb.addEventListener('click', ccBootLeads);
    });
}

/* ===== MANUAL CONTACTS (Add Contact) =====
   Merge any manually-added contacts (stored in ccState.manual) back into
   CC_LEADS so the queue/follow-up logic — which iterates CC_LEADS and looks up
   ccState.pending[l.id] — can see them. Must run AFTER the Number() coercion in
   ccBootLeads, or these string ids get wiped to NaN. Idempotent: re-merging
   the same id just refreshes the object. */
function ccRehydrateManual(){
  if(!ccState.manual) return;
  Object.keys(ccState.manual).forEach(id=>{
    const m = ccState.manual[id];
    if(!m) return;
    const existing = CC_LEADS.findIndex(l=>String(l.id)===String(id));
    if(existing>=0) CC_LEADS[existing] = m; else CC_LEADS.push(m);
  });
}

/* Build a lead object in the same shape the Sheet leads use:
   {id,b,p,pd,c,r,t,w,hs,pr,tags}. Everything optional. */
function ccMakeManualLead(f){
  const digits = (f.phone||'').replace(/\D/g,'');
  return {
    id: ccNewManualId(),
    b:  f.business||'',
    p:  digits,                 // raw digits (search compares digits-only)
    pd: f.phone||'',            // display phone (what scripts/cards show)
    c:  f.city||'',
    r:  '',                     // rating — unknown for manual adds
    t:  f.trade||'',
    w:  '',                     // website — unknown
    hs: false,
    pr: f.note||'',             // reuse the "problem" slot as the freeform note
    tags: ['manual'],
    _manual: true,
    _email: f.email||'',        // kept for the Sheet row; cards don't use it
    _contact: f.contact||''
  };
}


const CC_CHIPS = ["No website","Site down/error","Only a few pages","Free site builder","Not secure (HTTP)","Generic email","Looks outdated","Slow site"];
const CC_PASSWORD = "callsoncall";
const CC_SHEET_URL = "https://script.google.com/macros/s/AKfycbySuUc1-9uz9X7XIU1a39Ydob8eaDq89XmDeUd-RakTh81idxFx0gfTfIR6fEiVplPd/exec"; // <-- replace after deploying Apps Script

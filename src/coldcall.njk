function wireCard(l, listLen){
  const vmBtn = document.querySelector('[data-vmtoggle]');
  if(vmBtn){ vmBtn.addEventListener('click', ()=>{
    const body = document.getElementById('ccVmBody');
    body.classList.toggle('cc-collapsed');
    vmBtn.classList.toggle('cc-open', !body.classList.contains('cc-collapsed'));
  }); }
  [...document.querySelectorAll('#ccStage .cc-rbtn')].forEach(b=>{
    b.addEventListener('click', ()=>{
      const act = b.dataset.act;
      if(act!=='good'){
        const LBL = { vm:'Voicemail logged', callback:'Call-back set for tomorrow', noanswer:'No answer — text queued', notint:'Marked not interested', dnc:'Marked do-not-call' };
        ccFlashBtn(b);
        ccToast('✓ '+l.b+' — '+(LBL[act]||'Saved'), 'ok');
      }
      dispositionFresh(l, act);
    });
  });
  const prev = document.getElementById('ccPrev');
  const next = document.getElementById('ccNext');
  prev.addEventListener('click', ()=>{ ccCursor--; render(); });
  next.addEventListener('click', ()=>{ ccCursor++; render(); });
  prev.disabled = listLen<=1; next.disabled = listLen<=1;
}
function markDone(l, result, extra){
  ccState.done[l.id] = result;
  if(!ccState.recs) ccState.recs = {};
  const prev = ccState.recs[l.id] || {};
  ccState.recs[l.id] = Object.assign({}, prev, {
    id: l.id, result: result,
    when: new Date().toLocaleString('en-US',{timeZone:'America/Chicago'}),
    notes: (extra && extra.notes!=null) ? extra.notes : (prev.notes||'')
  });
  saveState();
  ccFireEvent({ leadId:l.id, eventKind:'done', result:result, notes:(ccState.recs[l.id]||{}).notes||'' });
  buildFilters();   // city counts shift
  render();
}
/* ===== follow-up engine: route a disposition into pending or done ===== */
function ccSetPending(l, nextAction, days, resultLabel){
  if(!ccState.pending) ccState.pending={};
  const today = ccTodayKey();
  ccState.pending[l.id] = { id:l.id, nextAction:nextAction, due:ccAddDays(today,days) };
  if(!ccState.recs) ccState.recs={};
  const prev = ccState.recs[l.id]||{};
  ccState.recs[l.id] = Object.assign({}, prev, { id:l.id, result:resultLabel,
    when:new Date().toLocaleString('en-US',{timeZone:'America/Chicago'}),
    notes: prev.notes||'' });
  saveState();
  ccFireEvent({ leadId:l.id, eventKind:'pending', nextAction:nextAction, due:ccState.pending[l.id].due, notes:(ccState.recs[l.id]||{}).notes||'' });
  buildFilters(); ccCursor=0; render();
}
function ccClearPending(id){ if(ccState.pending) delete ccState.pending[id]; }
function ccReschedule(id, days){
  if(!ccState.pending || !ccState.pending[id]) return;
  ccState.pending[id].due = ccAddDays(ccTodayKey(), days);
  saveState();
  ccFireEvent({ leadId:Number(id)||id, eventKind:'pending', nextAction:ccState.pending[id].nextAction, due:ccState.pending[id].due, notes:(ccState.recs && ccState.recs[id]||{}).notes||'' });
  render();
}
/* dispositions from the FRESH card: route vm/callback into pending */
function dispositionFresh(l, act){
  if(act==='good'){ markDone(l,'good'); openSheet(l); return; }
  if(act==='vm'){ ccSetPending(l,'text',1,'vm'); return; }            // VM -> text +1
  if(act==='noanswer'){ ccSetPending(l,'text-noans',1,'noanswer'); return; } // no answer -> text +1
  if(act==='callback'){ ccSetPending(l,'callback',1,'callback'); return; } // call back +1
  markDone(l, act);  // notint / dnc -> done as before
}
/* escalate an exhausted lead to the sheet, flagged as snapshot (not deep-dive) */
function ccEscalateSnapshot(l){
  ccClearPending(l.id);
  ccState.done[l.id]='exhausted';
  if(!ccState.recs) ccState.recs={};
  const prev=ccState.recs[l.id]||{};
  ccState.recs[l.id]=Object.assign({},prev,{ id:l.id, result:'exhausted',
    when:new Date().toLocaleString('en-US',{timeZone:'America/Chicago'}), notes:prev.notes||'' });
  saveState(); buildFilters(); render();
  ccFireEvent({ leadId:l.id, eventKind:'done', result:'exhausted', notes:(ccState.recs[l.id]||{}).notes||'' });
  // fire to sheet with lead_type snapshot (reuses the same endpoint as good leads)
  try{
    if(CC_SHEET_URL && CC_SHEET_URL.indexOf('__SHEET')<0){
      const payload = { date:new Date().toLocaleString('en-US',{timeZone:'America/Chicago'}),
        business:l.b, phone:l.pd||'', trade:l.t, city:l.c,
        hasWebsite:(l.hs?'Yes':'No'), problem:(l.pr||''),
        lead_type:'snapshot', status:'Snapshot — phone sequence exhausted' };
      fetch(CC_SHEET_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(payload)}).catch(()=>{});
    }
  }catch(e){}
}
/* the follow-up action card (text / final text / call back) */
function openFollowUp(l){
  const p = ccState.pending && ccState.pending[l.id];
  if(!p){ return; }
  ccCurrentFollow = l;
  const ov = document.createElement('div');
  ov.className='cc-sheet-ov'; ov.id='ccFollowOv';
  let scriptLabel, scriptBody, actions;
  if(p.nextAction==='text' || p.nextAction==='text-noans'){
    const isNoAns = (p.nextAction==='text-noans');
    scriptLabel='💬 Touch 2 · next-day text (copy &amp; send from your phone)';
    scriptBody= isNoAns ? CC_TEXT_NOANS : CC_TEXT_DAY2;
    actions='<button class="cc-rbtn cc-good-btn" data-fact="good">They replied — Good lead</button>'+
            '<button class="cc-rbtn cc-vm" data-fact="textsent">✓ Text sent</button>';
  } else if(p.nextAction==='finaltext'){
    scriptLabel='💬 Touch 4 · final text';
    scriptBody=CC_TEXT_FINAL;
    actions='<button class="cc-rbtn cc-good-btn" data-fact="good">They replied — Good lead</button>'+
            '<button class="cc-rbtn cc-dnc" data-fact="finalsent" style="grid-column:1 / -1">✓ Final text sent → send to my list (snapshot)</button>';
  } else { // callback
    scriptLabel='📞 Touch 3 · call back';
    scriptBody=pickScript(l);
    actions='<button class="cc-rbtn cc-good-btn" data-fact="good">✓ Good lead</button>'+
            '<button class="cc-rbtn cc-vm" data-fact="vm">Left voicemail</button>'+
            '<button class="cc-rbtn cc-cb" data-fact="callback">Call back again</button>'+
            '<button class="cc-rbtn cc-ni" data-fact="notint">Not interested</button>'+
            '<button class="cc-rbtn cc-dnc" data-fact="dnc" style="grid-column:1 / -1">Bad / Do not call</button>';
  }
  const callable = l.p && l.p.length===10;
  ov.innerHTML = '<div class="cc-sheet"><button class="cc-sheet-x" id="ccFollowX">×</button>'+
    '<h2 class="cc-biz" style="margin-top:4px">'+esc(l.b)+'</h2>'+
    '<div class="cc-meta"><span class="cc-pill cc-city">'+esc(l.c)+'</span><span class="cc-pill">'+esc(l.t)+'</span>'+(l.r?'<span class="cc-pill cc-rate">★ '+esc(l.r)+'</span>':'')+'</div>'+
    (callable?'<a class="cc-call" href="tel:'+l.p+'">'+esc(l.pd)+'</a>':'')+
    '<div class="cc-script"><div class="cc-script-label">'+scriptLabel+'</div><div class="cc-script-body">'+scriptBody+'</div></div>'+
    '<div class="cc-results">'+actions+'</div>'+
    '<div class="cc-resched"><span class="cc-resched-lbl">Not today? Push it:</span>'+
      '<button data-resched="1">+1 day</button><button data-resched="3">+3 days</button><button data-resched="7">+1 week</button></div>'+
    '</div>';
  document.body.appendChild(ov);
  document.body.style.overflow='hidden';
  document.getElementById('ccFollowX').addEventListener('click', closeFollow);
  ov.addEventListener('click', e=>{ if(e.target.id==='ccFollowOv') closeFollow(); });
  [...ov.querySelectorAll('[data-fact]')].forEach(b=>{
    b.addEventListener('click', ()=>{
      const act=b.dataset.fact;
      if(act!=='good'){
        const LBL = { textsent:'Text sent — final text queued', finalsent:'Final text sent → moved to your list', vm:'Voicemail logged', callback:'Call-back set', notint:'Marked not interested', dnc:'Marked do-not-call' };
        ccFlashBtn(b);
        ccToast('✓ '+l.b+' — '+(LBL[act]||'Saved'), 'ok');
      }
      closeFollow();
      if(act==='good'){ ccClearPending(l.id); markDone(l,'good'); openSheet(l); return; }
      if(act==='textsent'){ ccSetPending(l,'finaltext',5,'text-sent'); return; }  // text -> final text +5
      if(act==='finalsent'){ ccEscalateSnapshot(l); return; }
      if(act==='vm'){ ccSetPending(l,'text',1,'vm'); return; }
      if(act==='callback'){ ccSetPending(l,'callback',1,'callback'); return; }
      // notint / dnc from a callback -> done
      ccClearPending(l.id); markDone(l, act);
    });
  });
  [...ov.querySelectorAll('[data-resched]')].forEach(b=>{
    b.addEventListener('click', ()=>{ const d=Number(b.dataset.resched)||1; closeFollow(); ccReschedule(l.id, d); });
  });
}
function closeFollow(){ const ov=document.getElementById('ccFollowOv'); if(ov) ov.remove(); document.body.style.overflow=''; ccCurrentFollow=null; }
function ccReset(){
  if(confirm("Reset ALL progress? This clears every result on this device.")){
    ccState = { done:{}, recs:{}, pending:{}, filter:"All" };
    ccQSearch=""; saveState(); buildFilters(); ccCursor=0;
    ccFireEvent({ leadId:'', eventKind:'reset' });
    if(ccView==='history'){ renderHistory(); } else { render(); }
  }
}

/* ============ SCORECARD SHEET ============ */
function openSheet(l){
  ccCurrentSheet = { lead:l, interest:"", dm:"", tags:[...(l.tags||[])] };
  const ov = document.createElement('div');
  ov.className='cc-sheet-ov'; ov.id='ccSheetOv';
  ov.innerHTML = sheetHtml(l);
  document.body.appendChild(ov);
  document.body.style.overflow='hidden';
  wireSheet(l);
}
function closeSheet(){
  const ov = document.getElementById('ccSheetOv');
  if(ov) ov.remove();
  document.body.style.overflow='';
  ccCurrentSheet = null;
}
function sheetHtml(l){
  const tagBtns = CC_CHIPS.map(t=>{
    const on = (l.tags||[]).includes(t);
    return '<button type="button" class="cc-tag'+(on?' cc-on':'')+'" data-tag="'+esc(t)+'">'+esc(t)+'</button>';
  }).join('');
  return ''+
  '<div class="cc-sheet" id="ccSheet">'+
    '<h2>'+esc(l.b)+'</h2>'+
    '<p class="cc-sub">Good lead — jot down whatever you got. Nothing here is required.</p>'+

    '<div class="cc-field"><label>Their email <span class="cc-hint">(most important — adds them to the email follow-up)</span></label>'+
      '<input type="email" id="scEmail" class="cc-star" placeholder="name@example.com" inputmode="email" autocapitalize="off"></div>'+

    '<div class="cc-field"><label>Contact name</label>'+
      '<input type="text" id="scName" placeholder="Who you talked to"></div>'+

    '<div class="cc-field"><label>How interested?</label>'+
      '<div class="cc-seg" id="scInterest">'+
        '<button type="button" data-v="Hot">🔥 Hot</button>'+
        '<button type="button" data-v="Warm">Warm</button>'+
        '<button type="button" data-v="Lukewarm">Lukewarm</button>'+
      '</div></div>'+

    '<div class="cc-field"><label>Decision maker?</label>'+
      '<div class="cc-seg" id="scDM">'+
        '<button type="button" data-v="Yes (owner)">Yes — owner</button>'+
        '<button type="button" data-v="No / not sure">No / not sure</button>'+
      '</div></div>'+

    '<div class="cc-field"><label>Has a website now?</label>'+
      '<div class="cc-seg" id="scSite">'+
        '<button type="button" data-v="Yes"'+(l.hs?' class="cc-sel-plain"':'')+'>Yes</button>'+
        '<button type="button" data-v="No"'+(!l.hs?' class="cc-sel-plain"':'')+'>No</button>'+
      '</div></div>'+

    '<div class="cc-field"><label>Main problem <span class="cc-hint">(pre-lit from what we know)</span></label>'+
      '<div class="cc-tags" id="scTags">'+tagBtns+'</div></div>'+

    '<div class="cc-field"><label>Best follow-up time</label>'+
      '<input type="text" id="scFollow" placeholder="e.g. Tomorrow AM, after 5pm…"></div>'+

    '<div class="cc-field"><label>Notes</label>'+
      '<textarea id="scNotes" rows="2" placeholder="Anything worth remembering"></textarea></div>'+

    '<div class="cc-sheet-actions">'+
      '<button class="cc-cancel" id="scCancel">Cancel</button>'+
      '<button class="cc-save" id="scSave">Save lead</button>'+
    '</div>'+
    '<div class="cc-savemsg" id="scMsg"></div>'+
  '</div>';
}
function wireSheet(l){
  // segmented controls
  segWire('scInterest', v=>{ ccCurrentSheet.interest=v; }, 'interest');
  segWire('scDM', v=>{ ccCurrentSheet.dm=v; }, 'dm');
  // site has its own default styling already
  const siteSeg = document.getElementById('scSite');
  siteSeg.dataset.val = l.hs ? "Yes" : "No";
  [...siteSeg.querySelectorAll('button')].forEach(b=>{
    b.addEventListener('click', ()=>{
      [...siteSeg.querySelectorAll('button')].forEach(x=>x.className='');
      b.className='cc-sel-plain'; siteSeg.dataset.val=b.dataset.v;
    });
  });
  // tags
  [...document.querySelectorAll('#scTags .cc-tag')].forEach(b=>{
    b.addEventListener('click', ()=>{
      b.classList.toggle('cc-on');
      const t=b.dataset.tag;
      const i=ccCurrentSheet.tags.indexOf(t);
      if(b.classList.contains('cc-on')){ if(i<0) ccCurrentSheet.tags.push(t); }
      else { if(i>=0) ccCurrentSheet.tags.splice(i,1); }
    });
  });
  document.getElementById('scCancel').addEventListener('click', closeSheet);
  document.getElementById('ccSheetOv').addEventListener('click', e=>{ if(e.target.id==='ccSheetOv') closeSheet(); });
  document.getElementById('scSave').addEventListener('click', ()=>saveLead(l));
}
function segWire(id, setter, key){
  const seg = document.getElementById(id);
  const cls = {interest:{Hot:'cc-sel-hot',Warm:'cc-sel-warm',Lukewarm:'cc-sel-luke'}, dm:{}}[key]||{};
  [...seg.querySelectorAll('button')].forEach(b=>{
    b.addEventListener('click', ()=>{
      [...seg.querySelectorAll('button')].forEach(x=>x.className='');
      b.className = cls[b.dataset.v] || 'cc-sel-plain';
      setter(b.dataset.v);
    });
  });
}
function saveLead(l){
  const btn = document.getElementById('scSave');
  const msg = document.getElementById('scMsg');
  const email = (document.getElementById('scEmail').value||'').trim();
  const payload = {
    date: new Date().toLocaleString('en-US',{timeZone:'America/Chicago'}),
    interest: ccCurrentSheet.interest||'',
    business: l.b,
    contact: (document.getElementById('scName').value||'').trim(),
    decisionMaker: ccCurrentSheet.dm||'',
    phone: l.pd||'',
    email: email,
    trade: l.t,
    city: l.c,
    hasWebsite: document.getElementById('scSite').dataset.val||'',
    problem: ccCurrentSheet.tags.join(', '),
    followUp: (document.getElementById('scFollow').value||'').trim(),
    notes: (document.getElementById('scNotes').value||'').trim(),
    status: 'New'
  };
  const validEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  btn.disabled=true; btn.classList.add('cc-saving'); btn.textContent='Saving…'; msg.className='cc-savemsg'; msg.textContent='';

  const tasks = [];
  // 1) sheet
  if(CC_SHEET_URL && CC_SHEET_URL.indexOf('__SHEET')<0){
    tasks.push(fetch(CC_SHEET_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(payload)}).catch(()=>{}));
  }
  // 2) courier ONLY if valid email
  if(validEmail){
    tasks.push(fetch(CC_COURIER_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:email,name:payload.contact,business:payload.business,source:'cold-call'})}).catch(()=>{}));
  }
  Promise.all(tasks).then(()=>{
    // mark good + close regardless (no-cors gives opaque responses)
    msg.className='cc-savemsg cc-ok';
    msg.textContent = validEmail ? 'Saved + added to email follow-up.' : 'Saved to the sheet.';
    btn.classList.remove('cc-saving'); btn.classList.add('cc-flash'); btn.textContent='✓ Sent';
    ccToast(validEmail ? '✓ '+l.b+' saved + emailed' : '✓ '+l.b+' saved to the sheet', 'ok');
    setTimeout(()=>{ closeSheet(); markDone(l,'good',{notes: payload.notes}); }, 600);
  });
}


/* ============ HISTORY VIEW ============ */
let ccSearchTerm = "";
function leadById(id){ return CC_LEADS.find(l=>String(l.id)===String(id)); }

function renderHistory(){
  const wrap = document.getElementById('ccHistory');
  const recs = ccState.recs || {};
  const ids = Object.keys(recs);

  let searchBox = '<input class="cc-search" id="ccSearch" type="text" placeholder="Search all leads by business name…" value="'+esc(ccSearchTerm)+'">';

  // Search mode: searches ALL leads (processed or not)
  if(ccSearchTerm.trim()){
    const term = ccSearchTerm.trim().toLowerCase();
    const hits = CC_LEADS.filter(l => l.b.toLowerCase().includes(term));
    let html = searchBox + '<div class="cc-hsection">Search results ('+hits.length+')</div>';
    if(hits.length===0){ html += '<div class="cc-hempty">No business matches “'+esc(ccSearchTerm)+'”.</div>'; }
    else { hits.slice(0,60).forEach(l=>{ html += histRowHtml(l, recs[l.id]); }); }
    html += resetWrap();
    wrap.innerHTML = html;
    wireHistory();
    return;
  }

  // Default: Callbacks first, then everything else processed
  const callbacks = ids.filter(id=>recs[id].result==='callback').map(id=>leadById(id)).filter(Boolean);
  const others = ids.filter(id=>recs[id].result!=='callback').map(id=>leadById(id)).filter(Boolean)
                    .sort((a,b)=>{ // newest first by stored time string compare is unreliable; keep insertion-ish via id presence
                       return 0; });
  let html = searchBox;
  if(ids.length===0){
    html += '<div class="cc-hempty">No leads processed yet on this device.<br>Once you action leads in the Queue, they show up here.</div>' + resetWrap();
    wrap.innerHTML = html; wireHistory(); return;
  }
  html += '<div class="cc-hsection">📞 Call backs ('+callbacks.length+')</div>';
  if(callbacks.length===0){ html += '<div class="cc-hempty" style="padding:18px">None waiting for a call back.</div>'; }
  else { callbacks.forEach(l=> html += histRowHtml(l, recs[l.id], true)); }

  html += '<div class="cc-hsection">All processed ('+others.length+')</div>';
  others.forEach(l=> html += histRowHtml(l, recs[l.id]));
  html += resetWrap();
  wrap.innerHTML = html;
  wireHistory();
}

function resetWrap(){
  return '<div class="cc-resetwrap"><button id="ccResetHist">Reset all progress (restore full list)</button></div>';
}

function histRowHtml(l, rec, isCb){
  rec = rec || {};
  const editing = String(ccEditId)===String(l.id);
  const result = rec.result || '';
  const label = CC_RESULT_LABELS[result] || (result? result : 'Not processed');
  const callable = l.p && l.p.length===10;
  const badge = result ? '<span class="cc-badge cc-b-'+result+'">'+esc(label)+'</span>' : '';
  let inner = ''+
    '<div class="cc-hrow-top">'+
      '<div><div class="cc-hbiz">'+esc(l.b)+'</div>'+
        '<div class="cc-hmeta">'+esc(l.c)+' · '+esc(l.t)+(rec.when?(' · '+esc(rec.when)):'')+'</div></div>'+
      badge +
    '</div>';
  if(rec.notes){ inner += '<div class="cc-hnotes">'+esc(rec.notes)+'</div>'; }

  if(editing){
    inner += ''+
      '<div style="margin-top:12px">'+
        '<label style="font-size:.78rem;font-weight:700;color:var(--cc-navy);display:block;margin-bottom:5px">Change result</label>'+
        '<select class="cc-search" id="ccEditResult" style="margin:0 0 10px">'+
          ['good','callback','vm','noanswer','notint','dnc'].map(r=>'<option value="'+r+'"'+(r===result?' selected':'')+'>'+CC_RESULT_LABELS[r]+'</option>').join('')+
        '</select>'+
        '<label style="font-size:.78rem;font-weight:700;color:var(--cc-navy);display:block;margin-bottom:5px">Notes</label>'+
        '<textarea class="cc-search" id="ccEditNotes" rows="3" style="margin:0 0 10px">'+esc(rec.notes||'')+'</textarea>'+
        '<div class="cc-hactions">'+
          '<button class="cc-ha cc-ha-edit" data-act="canceledit" data-id="'+l.id+'">Cancel</button>'+
          '<button class="cc-ha cc-ha-reopen" data-act="saveedit" data-id="'+l.id+'">Save</button>'+
        '</div>'+
      '</div>';
  } else {
    inner += '<div class="cc-hactions">'+
      '<a class="cc-ha cc-ha-call'+(callable?'':' cc-disabled')+'" href="'+(callable?('tel:'+l.p):'#')+'">📞 Call</a>'+
      '<button class="cc-ha cc-ha-edit" data-act="edit" data-id="'+l.id+'">Edit</button>'+
      '<button class="cc-ha cc-ha-reopen" data-act="reopen" data-id="'+l.id+'">Re-open</button>'+
    '</div>';
  }
  return '<div class="cc-hrow'+(isCb?' cc-cb-row':'')+'">'+inner+'</div>';
}

function wireHistory(){
  const s = document.getElementById('ccSearch');
  if(s){ s.addEventListener('input', e=>{ ccSearchTerm = e.target.value; const pos=e.target.selectionStart; renderHistory(); const ns=document.getElementById('ccSearch'); if(ns){ ns.focus(); try{ns.setSelectionRange(pos,pos);}catch(_){} } }); }
  const rh = document.getElementById('ccResetHist');
  if(rh){ rh.addEventListener('click', ccReset); }
  [...document.querySelectorAll('#ccHistory [data-act]')].forEach(b=>{
    b.addEventListener('click', ()=>{
      const id = b.dataset.id, act = b.dataset.act;
      if(act==='edit'){ ccEditId = id; renderHistory(); }
      else if(act==='canceledit'){ ccEditId = null; renderHistory(); }
      else if(act==='reopen'){ reopenLead(id); }
      else if(act==='saveedit'){ saveEdit(id); }
    });
  });
}

function reopenLead(id){
  const l = leadById(id);
  if(!l) return;
  if(confirm('Put "'+l.b+'" back in the call queue?')){
    delete ccState.done[id];
    if(ccState.recs) delete ccState.recs[id];
    saveState();
    ccFireEvent({ leadId:Number(id)||id, eventKind:'undo' });
    buildFilters(); renderHistory();
  }
}
function saveEdit(id){
  const res = document.getElementById('ccEditResult').value;
  const notes = document.getElementById('ccEditNotes').value;
  if(!ccState.recs) ccState.recs={};
  const prev = ccState.recs[id]||{};
  ccState.done[id] = res;
  ccState.recs[id] = Object.assign({}, prev, { id:Number(id)||id, result:res, notes:notes,
    when: new Date().toLocaleString('en-US',{timeZone:'America/Chicago'}) });
  ccEditId = null;
  saveState();
  ccFireEvent({ leadId:Number(id)||id, eventKind:'done', result:res, notes:notes });
  buildFilters(); renderHistory();
}

/* ============ util ============ */
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
</script>

---
layout: layouts/base.njk
---

{# Override the base.njk default description with the article excerpt #}
{% set description = excerpt %}

{# Article structured data for Google #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title | escape }}",
  "description": "{{ excerpt | escape }}",
  "author": {
    "@type": "Person",
    "name": "{{ author | default('Irene Daniels') }}"
  },
  "datePublished": "{{ date | htmlDateString }}",
  "dateModified": "{{ date | htmlDateString }}",
  "publisher": {
    "@type": "Organization",
    "name": "Sites On Call",
    "url": "https://sitesoncall.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://sitesoncall.com/logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://sitesoncall.com{{ page.url }}"
  },
  "url": "https://sitesoncall.com{{ page.url }}",
  "inLanguage": "en-US"{% if tags %},
  "keywords": "{% for tag in tags %}{{ tag }}{% if not loop.last %}, {% endif %}{% endfor %}"{% endif %}
}
</script>

<article class="article-content">
  <a href="/articles/" class="back-link">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    Back to Articles
  </a>
  
  <h1>{{ title }}</h1>
  
  <div class="article-meta">
    <span>{{ date | readableDate }}</span>
    {% if author %}
      <span> · By {{ author }}</span>
    {% endif %}
  </div>
  
  <div class="article-body">
    {{ content | safe }}
  </div>
</article>

<section class="article-cta">
  <div class="section-inner">
    <div class="article-cta-card">
      <div class="article-cta-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="M21 21l-4.35-4.35"/>
          <path d="M11 8v6M8 11h6"/>
        </svg>
      </div>
      <div class="article-cta-content">
        <h3>Curious how your business looks online?</h3>
        <p>I'll pull together a free Online Presence Snapshot for your business — what's working, what's broken, and who's showing up instead of you on Google. No sales pitch, just useful info.</p>
        <a href="javascript:void(0)" onclick="openContactModal(true)" class="btn-primary">
          Get Your Free Snapshot
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

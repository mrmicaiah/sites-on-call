<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default("Sites On Call — Websites for Contractors in North Alabama") }}</title>
  <meta name="description" content="{{ description | default("Websites and SEO content for contractors tired of Angi, HomeAdvisor, and expensive Google Ads. Build an asset you own. No contracts.") }}">
  {% if noindex %}<meta name="robots" content="noindex,nofollow">{% endif %}

  {# Favicon - Sites On Call logo via Cloudinary (resized on-the-fly, single source images).
     Light logo (white) shows on dark tabs; Dark logo shows on light tabs.
     The unconditional Dark links at the end are the fallback for browsers that
     ignore the media attribute on icon links. Apple touch icon uses Dark (home screens vary). #}
  <link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" href="https://res.cloudinary.com/dxzw1zwez/image/upload/w_32,h_32,c_fit,f_png/v1781278062/LOGO_SOC_Light_fubtbt.png">
  <link rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: dark)" href="https://res.cloudinary.com/dxzw1zwez/image/upload/w_16,h_16,c_fit,f_png/v1781278062/LOGO_SOC_Light_fubtbt.png">
  <link rel="icon" type="image/png" sizes="32x32" href="https://res.cloudinary.com/dxzw1zwez/image/upload/w_32,h_32,c_fit,f_png/v1781278062/LOGO_SOC_Dark_ckqhrm.png">
  <link rel="icon" type="image/png" sizes="16x16" href="https://res.cloudinary.com/dxzw1zwez/image/upload/w_16,h_16,c_fit,f_png/v1781278062/LOGO_SOC_Dark_ckqhrm.png">
  <link rel="apple-touch-icon" sizes="180x180" href="https://res.cloudinary.com/dxzw1zwez/image/upload/w_180,h_180,c_fit,f_png/v1781278062/LOGO_SOC_Dark_ckqhrm.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">

  {# Default social-share image: 1200x630 logo card hosted on imgbb (i.ibb.co).
     ROOT CAUSE of the long "corrupted image" saga: the shared Cloudinary account
     (dxzw1zwez, serves multiple client sites) has "Resource list" restricted under
     Security > Restricted image types, which blocks unsigned image delivery to bots
     like Facebook's scraper (facebookexternalhit) — images loaded in browsers but FB
     was refused. That setting is account-wide and we chose NOT to loosen it (other
     client sites on the same account, risk unknown). So this one OG image is hosted
     off-Cloudinary on imgbb, a plain public host FB can fetch. Favicons above still
     use Cloudinary because browsers (not bots) load them, so the restriction doesn't bite.
     Per-page `image` (e.g. article featured images) overrides this default. #}
  {% set ogImage = image | default("https://i.ibb.co/vFB0kwf/og-default.jpg") %}
  
  {# Open Graph tags #}
  <meta property="og:title" content="{{ title | default('Sites On Call') }}">
  <meta property="og:description" content="{{ description | default('Websites for contractors who are done paying for leads.') }}">
  <meta property="og:type" content="{{ ogType | default('website') }}">
  <meta property="og:url" content="https://sitesoncall.com{{ page.url }}">
  <meta property="og:site_name" content="Sites On Call">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  {# Twitter Card tags #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title | default('Sites On Call') }}">
  <meta name="twitter:description" content="{{ description | default('Websites for contractors who are done paying for leads.') }}">
  <meta name="twitter:image" content="{{ ogImage }}">
  
  {# Canonical URL #}
  <link rel="canonical" href="https://sitesoncall.com{{ page.url }}">
  
  {# LocalBusiness Schema - Only on homepage #}
  {% if page.url == '/' %}

---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://sitesoncall.com/</loc>
    <lastmod>{{ page.date | htmlDateString }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://sitesoncall.com/articles/</loc>
    <lastmod>{{ page.date | htmlDateString }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://sitesoncall.com/the-build/</loc>
    <lastmod>{{ page.date | htmlDateString }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {%- for loc in collections.locations %}
  {%- if not loc.data.noindex %}
  <url>
    <loc>https://sitesoncall.com{{ loc.url }}</loc>
    <lastmod>{{ page.date | htmlDateString }}</lastmod>
    <changefreq>monthly</changefreq>
    {%- if (loc.url | split("/") | length) <= 4 %}
    <priority>0.9</priority>
    {%- else %}
    <priority>0.8</priority>
    {%- endif %}
  </url>
  {%- endif %}
  {%- endfor %}
  {%- for article in articles %}
  <url>
    <loc>https://sitesoncall.com{{ article.url }}</loc>
    <lastmod>{{ article.publishedAt | truncate(10, true, '') }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {%- endfor %}
</urlset>
